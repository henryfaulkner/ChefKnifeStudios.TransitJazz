{
  "apiVersion": 1,
  "groups": [
    {
      "name": "transitjazz-worker",
      "folder": "TransitJazz",
      "interval": "10s",
      "rules": [
        {
          "name": "WorkerStalled",
          "condition": "time() - {__name__=\"transitjazz.worker.last_cycled_seconds\"} > 3 * {__name__=\"transitjazz.worker.cycle_interval_seconds\"}",
          "for": "0s", "severity": "critical", "noDataState": "Alerting",
          "summary": "Worker heartbeat is older than three configured intervals."
        },
        {
          "name": "WorkerGone",
          "condition": "absent({__name__=\"transitjazz.worker.cycles_total\"})",
          "for": "0s", "severity": "critical", "noDataState": "Alerting",
          "summary": "Worker full-cycle series is absent."
        },
        {
          "name": "CityMissing",
          "condition": "present_over_time({__name__=\"transitjazz.worker.city.last_cycled_seconds\"}[6h]) unless present_over_time({__name__=\"transitjazz.worker.city.last_cycled_seconds\"}[30s])",
          "for": "0s", "severity": "critical", "noDataState": "Alerting",
          "labels": {"transit_city": "{{ index $labels \"transit.city\" }}"},
          "summary": "Configured city is absent from the recent three-tick window."
        },
        {
          "name": "CityInputStopped",
          "condition": "max_over_time({__name__=\"transitjazz.worker.city.has_input_records\"}[15m]) == 0",
          "for": "15m", "severity": "warning", "noDataState": "Alerting",
          "labels": {"transit_city": "{{ index $labels \"transit.city\" }}"},
          "summary": "City has no input for 15 minutes."
        },
        {
          "name": "CityCycleErrors",
          "condition": "increase({__name__=\"transitjazz.worker.city.cycle_errors_total\"}[15m]) > 0",
          "for": "0s", "severity": "warning", "noDataState": "Alerting",
          "labels": {"transit_city": "{{ index $labels \"transit.city\" }}"},
          "summary": "City has a recent cycle error."
        },
        {
          "name": "CityCycleSlow",
          "condition": "histogram_quantile(0.95, sum by (le, \"transit.city\") (rate({__name__=\"transitjazz.worker.city.cycle_duration_seconds_bucket\"}[15m]))) > 30",
          "for": "15m", "severity": "warning", "noDataState": "Alerting",
          "labels": {"transit_city": "{{ index $labels \"transit.city\" }}"},
          "summary": "City p95 cycle duration exceeds 30 seconds."
        },
        {
          "name": "CityInputLagHigh",
          "condition": "min_over_time({__name__=\"transitjazz.worker.city.input_timestamp_known\"}[10m]) == 1 and min_over_time({__name__=\"transitjazz.worker.city.input_lag_seconds\"}[10m]) > 900",
          "for": "10m", "severity": "warning", "noDataState": "Alerting",
          "labels": {"transit_city": "{{ index $labels \"transit.city\" }}"},
          "summary": "City input lag exceeds 900 seconds with a known timestamp."
        }
      ]
    }
  ]
}
