{
  "$schema": "https://schema.management.azure.com/schemas/2018-05-01/subscriptionDeploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.43.8.12551",
      "templateHash": "12293727463877958617"
    }
  },
  "parameters": {
    "projectName": {
      "type": "string",
      "defaultValue": "marta-jazz",
      "metadata": {
        "description": "Project name used as prefix in all resource names."
      }
    },
    "environment": {
      "type": "string",
      "allowedValues": [
        "dev",
        "prod"
      ],
      "metadata": {
        "description": "Deployment environment."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "eastus2",
      "metadata": {
        "description": "Primary Azure region for regional resources."
      }
    },
    "apexDomain": {
      "type": "string",
      "defaultValue": "martajazz.com",
      "metadata": {
        "description": "Custom apex domain for the site (e.g., martajazz.com)."
      }
    },
    "repositoryUrl": {
      "type": "string",
      "defaultValue": "https://github.com/henryfaulkner/ChefKnifeStudios.TransitJazz",
      "metadata": {
        "description": "GitHub repository URL for the Static Web App source."
      }
    },
    "repositoryToken": {
      "type": "securestring",
      "metadata": {
        "description": "GitHub Personal Access Token for SWA deployment."
      }
    },
    "bindCustomDomains": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Bind custom domains to the SWA. Set false on first deploy (DNS zone must exist first); set true on subsequent deploys."
      }
    }
  },
  "variables": {
    "namePrefix": "[format('{0}-{1}', parameters('projectName'), parameters('environment'))]",
    "resourceGroupName": "[format('{0}-rg', variables('namePrefix'))]",
    "tags": {
      "env": "[parameters('environment')]",
      "project": "[parameters('projectName')]"
    },
    "staticWebAppName": "[format('{0}-swa', variables('namePrefix'))]",
    "staticWebAppResourceId": "[format('/subscriptions/{0}/resourceGroups/{1}/providers/Microsoft.Web/staticSites/{2}', subscription().subscriptionId, variables('resourceGroupName'), variables('staticWebAppName'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Resources/resourceGroups",
      "apiVersion": "2024-03-01",
      "name": "[variables('resourceGroupName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]"
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "dnsZone-deploy",
      "resourceGroup": "[variables('resourceGroupName')]",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "zoneName": {
            "value": "[parameters('apexDomain')]"
          },
          "tags": {
            "value": "[variables('tags')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.43.8.12551",
              "templateHash": "2389417886757056568"
            }
          },
          "parameters": {
            "zoneName": {
              "type": "string",
              "metadata": {
                "description": "DNS zone name (e.g., martajazz.com). Note: this resource intentionally breaks the project naming convention because the zone name IS the domain."
              }
            },
            "tags": {
              "type": "object",
              "metadata": {
                "description": "Resource tags."
              }
            }
          },
          "resources": [
            {
              "type": "Microsoft.Network/dnsZones",
              "apiVersion": "2023-07-01-preview",
              "name": "[parameters('zoneName')]",
              "location": "global",
              "tags": "[parameters('tags')]",
              "properties": {
                "zoneType": "Public"
              }
            }
          ],
          "outputs": {
            "id": {
              "type": "string",
              "value": "[resourceId('Microsoft.Network/dnsZones', parameters('zoneName'))]"
            },
            "nameServers": {
              "type": "array",
              "value": "[reference(resourceId('Microsoft.Network/dnsZones', parameters('zoneName')), '2023-07-01-preview').nameServers]"
            }
          }
        }
      },
      "dependsOn": [
        "[subscriptionResourceId('Microsoft.Resources/resourceGroups', variables('resourceGroupName'))]"
      ]
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "swa-deploy",
      "resourceGroup": "[variables('resourceGroupName')]",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "name": {
            "value": "[variables('staticWebAppName')]"
          },
          "location": {
            "value": "eastus2"
          },
          "tags": {
            "value": "[variables('tags')]"
          },
          "repositoryUrl": {
            "value": "[parameters('repositoryUrl')]"
          },
          "repositoryToken": {
            "value": "[parameters('repositoryToken')]"
          },
          "branch": {
            "value": "main"
          },
          "customDomains": "[if(parameters('bindCustomDomains'), createObject('value', createArray(parameters('apexDomain'), format('www.{0}', parameters('apexDomain')))), createObject('value', createArray()))]"
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.43.8.12551",
              "templateHash": "13239262728270831277"
            }
          },
          "parameters": {
            "name": {
              "type": "string",
              "metadata": {
                "description": "Name of the Static Web App."
              }
            },
            "location": {
              "type": "string",
              "defaultValue": "eastus2",
              "metadata": {
                "description": "Location for the SWA (Free SKU is regional, East US 2 supported)."
              }
            },
            "tags": {
              "type": "object",
              "metadata": {
                "description": "Resource tags."
              }
            },
            "repositoryUrl": {
              "type": "string",
              "metadata": {
                "description": "Source repository URL (GitHub)."
              }
            },
            "branch": {
              "type": "string",
              "defaultValue": "main",
              "metadata": {
                "description": "Deployment branch."
              }
            },
            "repositoryToken": {
              "type": "securestring",
              "metadata": {
                "description": "GitHub PAT for SWA deployment."
              }
            },
            "customDomains": {
              "type": "array",
              "defaultValue": [],
              "metadata": {
                "description": "Custom domains to bind to the SWA (apex + www)."
              }
            }
          },
          "resources": [
            {
              "type": "Microsoft.Web/staticSites",
              "apiVersion": "2024-04-01",
              "name": "[parameters('name')]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "sku": {
                "name": "Standard",
                "tier": "Standard"
              },
              "properties": {
                "repositoryUrl": "[parameters('repositoryUrl')]",
                "branch": "[parameters('branch')]",
                "repositoryToken": "[parameters('repositoryToken')]",
                "buildProperties": {
                  "appLocation": "src/Client/ChefKnifeStudios.TransitJazz.Client.WebApp",
                  "apiLocation": "",
                  "outputLocation": "wwwroot"
                }
              }
            },
            {
              "copy": {
                "name": "domains",
                "count": "[length(parameters('customDomains'))]"
              },
              "type": "Microsoft.Web/staticSites/customDomains",
              "apiVersion": "2024-04-01",
              "name": "[format('{0}/{1}', parameters('name'), parameters('customDomains')[copyIndex()])]",
              "properties": {
                "validationMethod": "[if(equals(parameters('customDomains')[copyIndex()], parameters('customDomains')[0]), 'dns-txt-token', 'cname-delegation')]"
              },
              "dependsOn": [
                "[resourceId('Microsoft.Web/staticSites', parameters('name'))]"
              ]
            }
          ],
          "outputs": {
            "id": {
              "type": "string",
              "value": "[resourceId('Microsoft.Web/staticSites', parameters('name'))]"
            },
            "name": {
              "type": "string",
              "value": "[parameters('name')]"
            },
            "defaultHostname": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.Web/staticSites', parameters('name')), '2024-04-01').defaultHostname]"
            }
          }
        }
      },
      "dependsOn": [
        "[subscriptionResourceId('Microsoft.Resources/resourceGroups', variables('resourceGroupName'))]"
      ]
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "dns-apex-a-deploy",
      "resourceGroup": "[variables('resourceGroupName')]",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "zoneName": {
            "value": "[parameters('apexDomain')]"
          },
          "staticWebAppResourceId": {
            "value": "[variables('staticWebAppResourceId')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.43.8.12551",
              "templateHash": "10209747254750038382"
            }
          },
          "parameters": {
            "zoneName": {
              "type": "string",
              "metadata": {
                "description": "DNS zone name (e.g., martajazz.com)."
              }
            },
            "staticWebAppResourceId": {
              "type": "string",
              "metadata": {
                "description": "Static Web App resource ID to alias the apex A record to."
              }
            },
            "recordTtl": {
              "type": "int",
              "defaultValue": 12960000,
              "metadata": {
                "description": "TTL for the record set (seconds)."
              }
            }
          },
          "resources": [
            {
              "type": "Microsoft.Network/dnsZones/A",
              "apiVersion": "2023-07-01-preview",
              "name": "[format('{0}/{1}', parameters('zoneName'), '@')]",
              "properties": {
                "TTL": "[parameters('recordTtl')]",
                "targetResource": {
                  "id": "[parameters('staticWebAppResourceId')]"
                }
              }
            }
          ]
        }
      },
      "dependsOn": [
        "[extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, variables('resourceGroupName')), 'Microsoft.Resources/deployments', 'dnsZone-deploy')]",
        "[subscriptionResourceId('Microsoft.Resources/resourceGroups', variables('resourceGroupName'))]",
        "[extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, variables('resourceGroupName')), 'Microsoft.Resources/deployments', 'swa-deploy')]"
      ]
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "dns-www-cname-deploy",
      "resourceGroup": "[variables('resourceGroupName')]",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "zoneName": {
            "value": "[parameters('apexDomain')]"
          },
          "swaDefaultHostname": {
            "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, variables('resourceGroupName')), 'Microsoft.Resources/deployments', 'swa-deploy'), '2025-04-01').outputs.defaultHostname.value]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.43.8.12551",
              "templateHash": "1158931464541845325"
            }
          },
          "parameters": {
            "zoneName": {
              "type": "string",
              "metadata": {
                "description": "DNS zone name (e.g., martajazz.com)."
              }
            },
            "swaDefaultHostname": {
              "type": "string",
              "metadata": {
                "description": "SWA default hostname to point www at (e.g., foo.azurestaticapps.net)."
              }
            },
            "recordTtl": {
              "type": "int",
              "defaultValue": 12960000,
              "metadata": {
                "description": "TTL for the record set (seconds)."
              }
            }
          },
          "resources": [
            {
              "type": "Microsoft.Network/dnsZones/CNAME",
              "apiVersion": "2023-07-01-preview",
              "name": "[format('{0}/{1}', parameters('zoneName'), 'www')]",
              "properties": {
                "TTL": "[parameters('recordTtl')]",
                "CNAMERecord": {
                  "cname": "[parameters('swaDefaultHostname')]"
                }
              }
            }
          ]
        }
      },
      "dependsOn": [
        "[extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, variables('resourceGroupName')), 'Microsoft.Resources/deployments', 'dnsZone-deploy')]",
        "[subscriptionResourceId('Microsoft.Resources/resourceGroups', variables('resourceGroupName'))]",
        "[extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, variables('resourceGroupName')), 'Microsoft.Resources/deployments', 'swa-deploy')]"
      ]
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "observability-kv-deploy",
      "resourceGroup": "[variables('resourceGroupName')]",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "name": {
            "value": "[take(format('{0}-kv', variables('namePrefix')), 24)]"
          },
          "location": {
            "value": "[parameters('location')]"
          },
          "tags": {
            "value": "[variables('tags')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.43.8.12551",
              "templateHash": "5633932636027397447"
            }
          },
          "parameters": {
            "name": {
              "type": "string"
            },
            "location": {
              "type": "string"
            },
            "tags": {
              "type": "object"
            }
          },
          "resources": [
            {
              "type": "Microsoft.KeyVault/vaults",
              "apiVersion": "2023-07-01",
              "name": "[parameters('name')]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "properties": {
                "tenantId": "[subscription().tenantId]",
                "sku": {
                  "family": "A",
                  "name": "standard"
                },
                "enableRbacAuthorization": true,
                "enablePurgeProtection": true,
                "enableSoftDelete": true
              }
            }
          ],
          "outputs": {
            "id": {
              "type": "string",
              "value": "[resourceId('Microsoft.KeyVault/vaults', parameters('name'))]"
            },
            "name": {
              "type": "string",
              "value": "[parameters('name')]"
            }
          }
        }
      },
      "dependsOn": [
        "[subscriptionResourceId('Microsoft.Resources/resourceGroups', variables('resourceGroupName'))]"
      ]
    }
  ],
  "outputs": {
    "resourceGroupName": {
      "type": "string",
      "value": "[variables('resourceGroupName')]"
    },
    "staticWebAppDefaultHostname": {
      "type": "string",
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, variables('resourceGroupName')), 'Microsoft.Resources/deployments', 'swa-deploy'), '2025-04-01').outputs.defaultHostname.value]"
    },
    "dnsZoneNameServers": {
      "type": "array",
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, variables('resourceGroupName')), 'Microsoft.Resources/deployments', 'dnsZone-deploy'), '2025-04-01').outputs.nameServers.value]"
    }
  }
}