@using ChefKnifeStudios.MartaJazz.Client.Shared.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<RouteFilterResources> Loc

<div class="audio-unlock-overlay">
    <div class="audio-unlock-overlay__inner">
        <div class="audio-unlock-overlay__body">
            <p>@Loc["AudioOverlayParagraph1"]</p>
            <p>@Loc["AudioOverlayParagraph2"]</p>
            <p>@Loc["AudioOverlayParagraph3"]</p>
        </div>
        <button type="button" class="audio-unlock-overlay__button" @onclick="OnEnable">
            @Loc["AudioOverlayButton"]
        </button>
    </div>
</div>

<style>
    .audio-unlock-overlay {
        position: fixed;
        inset: 0;
        z-index: 50;
        display: flex;
        align-items: flex-start;
        justify-content: center;
        overflow-y: auto;
        padding: 4rem 1.5rem;
        background: #fff;
        opacity: 1;
        transition: opacity 1s;
        pointer-events: auto;
    }

    @@media (min-width: 640px) {
        .audio-unlock-overlay {
            align-items: center;
            padding: 6rem 1.5rem;
        }
    }

    .audio-unlock-overlay__inner {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2rem;
        width: 100%;
        max-width: 34rem;
    }

    .audio-unlock-overlay__body {
        width: 100%;
        max-width: 34rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        text-align: left;
        font-family: monospace;
        font-size: 12px;
        line-height: 1.65;
        letter-spacing: 0.05em;
        color: rgba(0, 0, 0, 0.85);
    }

    .audio-unlock-overlay__body p {
        margin: 0;
    }

    @@media (min-width: 640px) {
        .audio-unlock-overlay__body {
            gap: 1.25rem;
            font-size: 13px;
            line-height: 1.7;
        }
    }

    @@media (min-width: 768px) {
        .audio-unlock-overlay__body {
            font-size: 14px;
        }
    }

    .audio-unlock-overlay__button {
        cursor: pointer;
        border-radius: 9999px;
        border: 1px solid rgba(0, 0, 0, 0.4);
        padding: 0.75rem 2rem;
        background: transparent;
        font-family: monospace;
        font-size: 11px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: rgba(0, 0, 0, 0.9);
        transition: transform 0.2s, border-color 0.2s, background 0.2s;
    }

    .audio-unlock-overlay__button:hover {
        transform: scale(1.03);
        border-color: rgba(0, 0, 0, 0.8);
        background: rgba(0, 0, 0, 0.05);
    }
</style>

@code {
    [Parameter, EditorRequired] public EventCallback OnEnable { get; set; }
}
