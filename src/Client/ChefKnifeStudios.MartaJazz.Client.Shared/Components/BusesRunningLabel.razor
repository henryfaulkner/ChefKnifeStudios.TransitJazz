@using System.ComponentModel
@using ChefKnifeStudios.MartaJazz.Client.Shared.Resources
@using Microsoft.Extensions.Localization
@implements IDisposable
@inject IRouteFilterViewModel RouteFilterViewModel
@inject IStringLocalizer<RouteFilterResources> Loc

<div class="buses-running-label">
    <MatBody2 class="buses-running-label__icon"></MatBody2>
    <MatBody2 class="route-filters__bus-count">@RouteFilterViewModel.ActiveBusCount</MatBody2>
    <MatBody2 class="route-filters__bus-label">@Loc["NumBusesRunning"]</MatBody2>
</div>

<style>
    .buses-running-label {
        display: flex;
        gap: 4px;
        align-items: center;
        justify-content: center;
        user-select: none;
        pointer-events: none;
    }

    .buses-running-label__icon {
        display: block;
        height: 12px;
        width: 12px;
        background-color: darkgreen;
        border-radius: 64px;
    }

    .route-filters__bus-count, .route-filters__bus-label {
        text-wrap-mode: nowrap;
        color: #171717;
        font-size: 12px;
    }
</style>

@code {
    protected override void OnInitialized()
        => RouteFilterViewModel.PropertyChanged += OnViewModelPropertyChanged;

    void OnViewModelPropertyChanged(object? sender, PropertyChangedEventArgs e)
    {
        if (e.PropertyName == nameof(IRouteFilterViewModel.ActiveBusCount))
            InvokeAsync(StateHasChanged);
    }

    public void Dispose()
        => RouteFilterViewModel.PropertyChanged -= OnViewModelPropertyChanged;
}