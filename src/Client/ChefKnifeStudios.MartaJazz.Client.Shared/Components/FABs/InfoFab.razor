@using ChefKnifeStudios.MartaJazz.Client.Core.Services
@using ChefKnifeStudios.MartaJazz.Client.Shared.EventArgs
@using ChefKnifeStudios.MartaJazz.Client.Shared.Resources
@using ChefKnifeStudios.MartaJazz.Client.Shared.Services
@using ChefKnifeStudios.MartaJazz.Shared
@using Microsoft.Extensions.Localization
@implements IDisposable
@inject IEventNotificationService EventNotificationService
@inject ISettingsService SettingsService
@inject IStringLocalizer<RouteFilterResources> Loc
@inject NavigationManager NavigationManager

<div class="info-fab-container">
    <MatFAB Icon="@(_isOpen ? "close" : "info_outline")" Mini="true" @onclick="Toggle" />
</div>

@if (_isOpen)
{
    <div class="info-overlay @(_isDark ? "info-overlay--dark" : "")"
         tabindex="-1"
         @ref="_overlayElement"
         @onkeydown="HandleKeyDown">
        <div class="info-overlay__inner">
            <div class="info-overlay__body">
                <p>@Loc[_prefix + "Paragraph1"]</p>
                <p>@Loc["InfoOverlayParagraph2"]</p>
                <p>@Loc["InfoOverlayParagraph3"]</p>
            </div>
            <button type="button" class="info-overlay__button" @onclick="() => _isOpen = false">
                @Loc["InfoOverlayButton"]
            </button>
        </div>
        <div class="info-overlay__footer">@Loc["InfoOverlayFooter"]</div>
    </div>
}

@code {
    bool _isOpen;
    bool _isDark;
    string _prefix = "InfoOverlay";
    ElementReference _overlayElement;
    bool _focusOnRender;

    protected override void OnInitialized()
    {
        _prefix = NavigationManager.ResolveCity() switch
        {
            CityNames.Wmata => "WmataOverlay",
            CityNames.Mbta  => "MbtaOverlay",
            CityNames.Nymta => "NymtaOverlay",
            CityNames.Ttc   => "TtcOverlay",
            CityNames.Septa => "SeptaOverlay",
            CityNames.Rtd   => "RtdOverlay",
            _               => "InfoOverlay"
        };
        _isDark = SettingsService.GetSettings().IsDarkModeEnabled;
        EventNotificationService.EventReceived += HandleEvent;
    }

    void Toggle()
    {
        _isOpen = !_isOpen;
        if (_isOpen)
            _focusOnRender = true;
    }

    void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            _isOpen = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusOnRender)
        {
            _focusOnRender = false;
            await _overlayElement.FocusAsync();
        }
    }

    void HandleEvent(object sender, IEventArgs e)
    {
        if (e is ThemeChangedEventArgs theme)
        {
            _isDark = theme.IsDarkMode;
            InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose() => EventNotificationService.EventReceived -= HandleEvent;
}
