@using ChefKnifeStudios.MartaJazz.Client.Core.Services
@using ChefKnifeStudios.MartaJazz.Client.Shared.Resources
@using ChefKnifeStudios.MartaJazz.Shared
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<RouteFilterResources> Loc
@inject NavigationManager NavigationManager

<div class="info-fab-container">
    <MatFAB Icon="@(_isOpen ? "close" : "info_outline")" Mini="true" @onclick="() => _isOpen = !_isOpen" />
</div>

@if (_isOpen)
{
    <div class="info-overlay">
        <div class="info-overlay__inner">
            <div class="info-overlay__body">
                <p>@Loc[_prefix + "Paragraph1"]</p>
                <p>@Loc["InfoOverlayParagraph2"]</p>
                <p>@Loc["InfoOverlayParagraph3"]</p>
            </div>
            <button type="button" class="info-overlay__button" @onclick="() => _isOpen = false">
                @Loc["InfoOverlayButton"]
            </button>
        </div>
        <div class="info-overlay__footer">@Loc["InfoOverlayFooter"]</div>
    </div>
}

@code {
    bool _isOpen;
    string _prefix = "InfoOverlay";

    protected override void OnInitialized()
    {
        if (NavigationManager.ResolveCity() == CityNames.Wmata)
            _prefix = "WmataOverlay";
    }
}
