@using ChefKnifeStudios.MartaJazz.Client.Core.Services
@using ChefKnifeStudios.MartaJazz.Client.Shared.EventArgs
@using ChefKnifeStudios.MartaJazz.Client.Shared.Models
@using ChefKnifeStudios.MartaJazz.Client.Shared.Services
@implements IDisposable
@inject IEventNotificationService EventNotificationService
@inject ISettingsService SettingsService

<div class="mapstyle-fab-container">
    <MatFAB Icon="@GetIcon()"
            Mini="true"
            @onclick="HandleToggleMapStyle" />
</div>

@code {
    Settings _settings = new();

    protected override void OnInitialized()
    {
        _settings = SettingsService.GetSettings();
    }

    string GetIcon() => _settings.IsStreetMapEnabled ? "map" : "layers";

    void HandleToggleMapStyle()
    {
        var newValue = !_settings.IsStreetMapEnabled;
        SettingsService.SetSettingValue(nameof(Settings.IsStreetMapEnabled), newValue);
        _settings = SettingsService.GetSettings();
        EventNotificationService.PostEvent(this, new GisSettingChangedEventArgs { IsStreetMapEnabled = _settings.IsStreetMapEnabled });
    }

    public void Dispose() { }
}
