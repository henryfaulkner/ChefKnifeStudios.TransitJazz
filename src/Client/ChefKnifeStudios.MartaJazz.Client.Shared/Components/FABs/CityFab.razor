@using ChefKnifeStudios.MartaJazz.Client.Core.Services
@using ChefKnifeStudios.MartaJazz.Shared
@using Microsoft.JSInterop
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<div class="city-fab-container">
    <MatFAB 
        Icon="location_city"
        Mini="true" 
        OnClick="OnClick2" 
        @ref="Button2"
    />
    <MatMenu @ref="Menu2" Class="city-fab-menu">
        <MatList>
            <MatListItem>
                <MatButton Label="Atlanta, GA" Mini="true" @onclick="HandleMartaClicked" Disabled="@(CurrentCity == CityNames.Marta)" />
            </MatListItem>
            <MatListItem>
                <MatButton Label="Boston, MA" Mini="true" @onclick="HandleMbtaClicked" Disabled="@(CurrentCity == CityNames.Mbta)" />
            </MatListItem>
            <MatListItem>
                <MatButton Label="New York, NY" Mini="true" @onclick="HandleNymtaClicked" Disabled="@(CurrentCity == CityNames.Nymta)" />
            </MatListItem>
            <MatListItem>
                <MatButton Label="Washington DC" Mini="true" @onclick="HandleWmataClicked"  Disabled="@(CurrentCity == CityNames.Wmata)" />
            </MatListItem>
            <MatListItem>
                <MatButton Label="Toronto, ON" Mini="true" @onclick="HandleTtcClicked" Disabled="@(CurrentCity == CityNames.Ttc)" />
            </MatListItem>
            <MatListItem>
                <MatButton Label="Philadelphia, PA" Mini="true" @onclick="HandleSeptaClicked" Disabled="@(CurrentCity == CityNames.Septa)" />
            </MatListItem>
        </MatList>
    </MatMenu>
</div>

@code {
    string CurrentCity => NavigationManager.ResolveCity();

    async Task HandleMartaClicked()
    {
        // Hash-only navigation is always in-page � no reload, WASM stays alive.
        // Set the hash then force a reload so the app re-bootstraps with the new city.
        await JS.InvokeVoidAsync("eval", $"location.hash='marta';location.reload()");
    }

    async Task HandleWmataClicked()
    {
        // Hash-only navigation is always in-page � no reload, WASM stays alive.
        // Set the hash then force a reload so the app re-bootstraps with the new city.
        await JS.InvokeVoidAsync("eval", $"location.hash='wmata';location.reload()");
    }

    async Task HandleMbtaClicked()
    {
        await JS.InvokeVoidAsync("eval", $"location.hash='mbta';location.reload()");
    }

    async Task HandleNymtaClicked()
    {
        await JS.InvokeVoidAsync("eval", $"location.hash='nymta';location.reload()");
    }

    async Task HandleTtcClicked()
    {
        await JS.InvokeVoidAsync("eval", $"location.hash='ttc';location.reload()");
    }

    async Task HandleSeptaClicked()
    {
        await JS.InvokeVoidAsync("eval", $"location.hash='septa';location.reload()");
    }

    MatFAB Button2;
    BaseMatMenu Menu2;
    public void OnClick2(MouseEventArgs e)
    {
        this.Menu2.OpenAsync(Button2.Ref);
    }
}
