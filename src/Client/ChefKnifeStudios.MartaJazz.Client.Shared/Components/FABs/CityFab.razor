@using Microsoft.JSInterop
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<div class="city-fab-container">
    <MatFAB Label="@CurrentCity.ToUpperInvariant()" Mini="true" @onclick="HandleToggle" />
</div>

@code {
    string CurrentCity
    {
        get
        {
            try
            {
                var fragment = new Uri(NavigationManager.Uri).Fragment.TrimStart('#');
                if (!string.IsNullOrWhiteSpace(fragment))
                    return fragment.ToLowerInvariant();
            }
            catch { }
            return "marta";
        }
    }

    async Task HandleToggle()
    {
        var next = CurrentCity == "marta" ? "wmata" : "marta";
        // Hash-only navigation is always in-page — no reload, WASM stays alive.
        // Set the hash then force a reload so the app re-bootstraps with the new city.
        await JS.InvokeVoidAsync("eval", $"location.hash='{next}';location.reload()");
    }
}
