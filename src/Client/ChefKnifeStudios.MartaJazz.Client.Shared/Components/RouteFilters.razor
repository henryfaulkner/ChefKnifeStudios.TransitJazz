@using ChefKnifeStudios.MartaJazz.Client.Shared.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<RouteFilterResources> Loc

@using ChefKnifeStudios.MartaJazz.Shared.Events

@{
    RenderFragment<RouteItem> RoutePill = routeItem =>
        @<div
            class="route-filters__route-filter"
            @onclick="() => HandleSelect(routeItem)"
            @onmouseover="(args) => HandleMouseOver(args, routeItem)"
            @onmouseout="(args) => HandleMouseOut(args, routeItem)"
        >
            <div
                class="route-filters__route-filter-circle @((RouteFilterViewModel.HasSelection || RouteFilterViewModel.HoveredRouteId != null) && !routeItem.IsSelected && routeItem.RouteId != RouteFilterViewModel.HoveredRouteId ? "route-filters__route-filter-disabled" : string.Empty)"
                style="--route-filter-color: @routeItem.Color"
            >
                <span class="route-filters__route-filter-label">
                    @routeItem.RouteId
                </span>
            </div>
        </div>;
}

<div class="route-filters">
    <div class="route-filters__controls">
        <div class="route-filters__route-filter" @onclick="HandleClearSelections">
            <div class="route-filters__route-filter-circle route-filters__clear-btn">
                <span class="route-filters__route-filter-label">@Loc["ClearSelections"]</span>
            </div>
        </div>
    </div>
    @if (RouteFilterViewModel.RouteItems.Any(r => r.Mode == TransitMode.Rail))
    {
        <div class="route-filters__section-label">@Loc["Rail"]</div>
        <div class="route-filters__rail">
            @foreach (var routeItem in RouteFilterViewModel.RouteItems.Where(r => r.Mode == TransitMode.Rail))
            {
                @RoutePill(routeItem)
            }
        </div>
    }
    @if (RouteFilterViewModel.RouteItems.Any(r => r.Mode == TransitMode.Bus))
    {
        <div class="route-filters__section-label">@Loc["Buses"]</div>
        <div class="route-filters__buses">
            @foreach (var routeItem in RouteFilterViewModel.RouteItems.Where(r => r.Mode == TransitMode.Bus))
            {
                @RoutePill(routeItem)
            }
        </div>
    }
</div>
