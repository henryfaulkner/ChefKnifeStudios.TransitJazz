@using ChefKnifeStudios.MartaJazz.Client.Core.Services
@using ChefKnifeStudios.MartaJazz.Client.Shared.EventArgs
@using ChefKnifeStudios.MartaJazz.Client.Shared.Resources
@using ChefKnifeStudios.MartaJazz.Client.Shared.Services
@using ChefKnifeStudios.MartaJazz.Shared.Events
@using Microsoft.Extensions.Localization
@inject IEventNotificationService EventNotificationService
@inject ISettingsService SettingsService
@inject IStringLocalizer<RouteFilterResources> Loc

@{
    RenderFragment<RouteItem> RoutePill = routeItem =>
        @<div
            class="route-filters__route-filter"
            @onclick="() => HandleSelect(routeItem)"
            @onmouseover="(args) => HandleMouseOver(args, routeItem)"
            @onmouseout="(args) => HandleMouseOut(args, routeItem)"
        >
            <div
                class="route-filters__route-filter-circle @((RouteFilterViewModel.HasSelection || RouteFilterViewModel.HoveredRouteJoinKey != null) && !routeItem.IsSelected && routeItem.RouteJoinKey != RouteFilterViewModel.HoveredRouteJoinKey ? "route-filters__route-filter-disabled" : string.Empty)"
                style="--route-filter-color: @routeItem.Color"
            >
                <span class="route-filters__route-filter-label">
                    @(routeItem.Label.Length > 5 ? routeItem.Label[..5] : routeItem.Label)
                </span>
            </div>
        </div>;
}

@{
    RenderFragment<TransitMode> SectionLabel = mode =>
        @<div class="route-filters__section-header @(mode == TransitMode.Rail ? "route-filters__section-header--rail" : "")">
            <MatSubtitle1 Class="route-filters__section-label route-filters__section-label--clickable" @onclick="() => HandleSelectAll(mode)">@Loc[mode == TransitMode.Rail ? "Rail" : "Buses"]</MatSubtitle1>
            @if (RouteFilterViewModel.HasSelectionFor(mode))
            {
                <MatIconButton
                    Icon="close"
                    Class="route-filters__clear-btn"
                    @onclick="() => HandleClearSelections(mode)"
                />
            }
        </div>;
}

<div class="route-filters @(_isDark ? "route-filters--dark" : "")">
    @if (RouteFilterViewModel.RouteItems.Any(r => r.Mode == TransitMode.Rail))
    {
        @SectionLabel(TransitMode.Rail)
        <div class="route-filters__rail">
            @foreach (var routeItem in RouteFilterViewModel.RouteItems.Where(r => r.Mode == TransitMode.Rail))
            {
                @RoutePill(routeItem)
            }
        </div>
    }
    @if (RouteFilterViewModel.RouteItems.Any(r => r.Mode == TransitMode.Bus))
    {
        @SectionLabel(TransitMode.Bus)
        <div class="route-filters__buses">
            @foreach (var routeItem in RouteFilterViewModel.RouteItems.Where(r => r.Mode == TransitMode.Bus))
            {
                @RoutePill(routeItem)
            }
        </div>
    }
</div>

@code {
    bool _isDark;

    void HandleDarkEvent(object sender, IEventArgs e)
    {
        if (e is ThemeChangedEventArgs theme)
        {
            _isDark = theme.IsDarkMode;
            InvokeAsync(StateHasChanged);
        }
    }
}
