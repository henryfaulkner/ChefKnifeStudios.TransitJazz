@using System.ComponentModel
@using ChefKnifeStudios.MartaJazz.Client.Shared.Resources
@using Microsoft.Extensions.Localization
@implements IDisposable
@inject IRouteFilterViewModel RouteFilterViewModel
@inject IStringLocalizer<RouteFilterResources> Loc

<div class="transit-running-label">
    @if (RouteFilterViewModel.ActiveRailCount > 0)
    {
        <div class="transit-running-label__row">
            <MatBody2 class="transit-running-label__icon transit-running-label__icon--rail"></MatBody2>
            <MatBody2 class="transit-running-label__count">@RouteFilterViewModel.ActiveRailCount</MatBody2>
            <MatBody2 class="transit-running-label__text">@Loc["NumTrainsRunning"]</MatBody2>
        </div>
    }
    @if (RouteFilterViewModel.ActiveBusCount > 0)
    {
        <div class="transit-running-label__row">
            <MatBody2 class="transit-running-label__icon transit-running-label__icon--bus"></MatBody2>
            <MatBody2 class="transit-running-label__count">@RouteFilterViewModel.ActiveBusCount</MatBody2>
            <MatBody2 class="transit-running-label__text">@Loc["NumBusesRunning"]</MatBody2>
        </div>
    }
</div>

<style>
    .transit-running-label {
        display: flex;
        flex-direction: column;
        gap: 2px;
        user-select: none;
        pointer-events: none;
    }

    .transit-running-label__row {
        display: flex;
        gap: 4px;
        align-items: center;
        justify-content: center;
    }

    .transit-running-label__icon {
        display: block;
        height: 12px;
        width: 12px;
        border-radius: 64px;
    }

    .transit-running-label__icon--rail {
        background-color: #1a237e;
    }

    .transit-running-label__icon--bus {
        background-color: darkgreen;
    }

    .transit-running-label__count, .transit-running-label__text {
        text-wrap-mode: nowrap;
        color: #171717;
        font-size: 12px;
    }
</style>

@code {
    protected override void OnInitialized()
        => RouteFilterViewModel.PropertyChanged += OnViewModelPropertyChanged;

    void OnViewModelPropertyChanged(object? sender, PropertyChangedEventArgs e)
    {
        if (e.PropertyName is nameof(IRouteFilterViewModel.ActiveBusCount) or nameof(IRouteFilterViewModel.ActiveRailCount))
            InvokeAsync(StateHasChanged);
    }

    public void Dispose()
        => RouteFilterViewModel.PropertyChanged -= OnViewModelPropertyChanged;
}
