@page "/"
@using ChefKnifeStudios.TransitJazz.Client.Shared.Components
@using ChefKnifeStudios.TransitJazz.Client.Shared.Resources
@using ChefKnifeStudios.TransitJazz.Client.Shared.Services.Audio
@using ChefKnifeStudios.TransitJazz.Client.Shared.Services.Notifications
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<RouteFilterResources> Loc

<div class="transit-map-container">
    <div class="transit-map__persistent-statuses">
        @if (ApplicationViewModel.LiveIssueCode is NotificationIssueCode liveIssueCode)
        {
            <div class="transit-map__persistent-status" role="note">
                <strong>@Loc[NotificationPolicy.GetSeverityResourceKey(liveIssueCode)]</strong>
                <p>@Loc[NotificationPolicy.GetImpactResourceKey(liveIssueCode)]</p>
                <p>@Loc[NotificationPolicy.GetActionResourceKey(liveIssueCode)]</p>
                <button type="button" @onclick="ReloadCurrentPage">@Loc["MapReload"]</button>
            </div>
        }
        @if (RouteIssueCode is NotificationIssueCode routeIssueCode)
        {
            <div class="transit-map__persistent-status" role="note">
                <strong>@Loc["ToastSeverityError"]</strong>
                <p>@Loc[NotificationPolicy.GetImpactResourceKey(routeIssueCode)]</p>
                <p>@Loc[NotificationPolicy.GetActionResourceKey(routeIssueCode)]</p>
                @if (routeIssueCode == NotificationIssueCode.RouteLoadFailed)
                {
                    <button type="button" @onclick="ReloadCurrentPage">@Loc["MapReload"]</button>
                }
            </div>
        }
        @if (_audioPlaybackUnavailable)
        {
            <div class="transit-map__persistent-status" role="note">
                <strong>@Loc["ToastSeverityError"]</strong>
                <p>@Loc[NotificationPolicy.GetImpactResourceKey(NotificationIssueCode.AudioUnavailable)]</p>
                <p>@Loc[NotificationPolicy.GetActionResourceKey(NotificationIssueCode.AudioUnavailable)]</p>
                <button type="button" @onclick="ReloadCurrentPage">@Loc["MapReload"]</button>
            </div>
        }
    </div>
    @if (!_audioUnlockState.Current.IsUnlocked && _audioUnlockState.Current.Status != AudioUnlockStatus.Muted)
    {
        <AudioUnlockOverlay OnEnable="EnableAudioAsync"
                            OnContinueWithoutAudio="ContinueWithoutAudioAsync"
                            UnlockStatus="@_audioUnlockState.Current.Status"
                            SettingOutcome="@_audioSettingOutcome" />
    }

    <div id="@_accordionElementId" class="transit-map__accordion @(_isMobile ? "transit-map__accordion-mobile" : "")">
        <MatAccordion Class="">
            <MatExpansionPanel @bind-Expanded="_accordionExpanded">
                <MatExpansionPanelSummary>
                    <MatExpansionPanelHeader>@Loc["RoutesLabel"]</MatExpansionPanelHeader>
                    <MatExpansionPanelSubHeader>
                        @if (_isMobile)
                        {
                            <TransitRunningLabel />
                        }
                    </MatExpansionPanelSubHeader>
                </MatExpansionPanelSummary>
                <MatExpansionPanelDetails>
                    <RouteFilters />
                </MatExpansionPanelDetails>
            </MatExpansionPanel>
        </MatAccordion>
    </div>

    @if (!_isMobile)
    {
        <div class="transit-map__top-text">
            <TransitRunningLabel />
        </div>
    }

    <Map CameraOptions="DefaultCameraOptions"
        OnMapReady="OnMapReadyAsync"
        OnMapBodyClicked="OnMapBodyClickedAsync"
        OnBusMarkerClicked="OnVehicleMarkerClickedAsync"
    />
    <RouteBlurbBar />
</div>

<style>
    .transit-map__accordion {
        display: block;
        position: absolute;
        left: 0;
        top: 0;
        width: 425px;
        z-index: 10;
    }

    .transit-map__accordion-mobile {
        width: 100%;
    }

    .transit-map__top-text {
        position: absolute;
        left: 50%;
        top: 24px;
        transform: translateX(-50%);
        z-index: 10;
        padding: 0.5rem 1rem;
        user-select: none;
        pointer-events: none;
    }

</style>

