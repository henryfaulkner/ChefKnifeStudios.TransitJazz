@using ChefKnifeStudios.TransitJazz.Client.Shared.ViewModels
@using ChefKnifeStudios.TransitJazz.Client.Shared.Resources
@using Microsoft.Extensions.Localization
@inject IApplicationViewModel ApplicationViewModel
@inject IStringLocalizer<RouteFilterResources> Loc

<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>@Loc["NotFoundTitle"]</PageTitle>
        <LayoutView Layout="@typeof(MainLayout)">
            <p role="alert">@Loc["NotFoundMessage"]</p>
        </LayoutView>
    </NotFound>
</Router>

@code {
    // Kick off app-lifetime singleton processes as early as possible, from inside the
    // Blazor DI scope (resolving these from the root provider in Program.cs throws,
    // because their graph reaches WASM scoped services). Fire-and-forget so the router
    // renders immediately; ApplicationViewModel.InitializeAsync is idempotent.
    protected override void OnInitialized()
    {
        _ = ApplicationViewModel.InitializeAsync();
    }
}
