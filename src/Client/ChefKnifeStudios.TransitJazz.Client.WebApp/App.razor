@using ChefKnifeStudios.TransitJazz.Client.Shared.ViewModels
@using ChefKnifeStudios.TransitJazz.Client.Shared.Resources
@using ChefKnifeStudios.TransitJazz.Client.Shared.Services
@using Microsoft.Extensions.Localization
@using ChefKnifeStudios.TransitJazz.Client.Core.Services
@using ChefKnifeStudios.TransitJazz.Client.Core.ClientExperience
@using ChefKnifeStudios.TransitJazz.Client.Shared.ClientExperience
@inject IApplicationViewModel ApplicationViewModel
@inject IStringLocalizer<RouteFilterResources> Loc
@inject NavigationManager NavigationManager
@inject StatsSnapshotStore StatsSnapshotStore
@inject ClientExperienceReporter ClientExperienceReporter
@inject ClientExperienceCaptureProxy ClientExperienceCaptureProxy
@implements IAsyncDisposable

<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>@Loc["NotFoundTitle"]</PageTitle>
        <LayoutView Layout="@typeof(MainLayout)">
            <p role="alert">@Loc["NotFoundMessage"]</p>
        </LayoutView>
    </NotFound>
</Router>

@code {
    // Kick off app-lifetime singleton processes as early as possible, from inside the
    // Blazor DI scope (resolving these from the root provider in Program.cs throws,
    // because their graph reaches WASM scoped services). ApplicationViewModel initialization
    // remains idempotent.
    protected override async Task OnInitializedAsync()
    {
        await ClientExperienceReporter.InitializeAsync();
        ClientExperienceCaptureProxy.SetTarget(ClientExperienceReporter);
        var city = NavigationManager.ResolveCity().ToLowerInvariant();
        var attemptId = ClientExperienceReporter.StartAttempt(city, "bootstrap_start", 60_000);
        try
        {
            await ApplicationViewModel.InitializeAsync();
            var ready = await ApplicationViewModel.RoutesLoadedTask;
            ClientExperienceReporter.FinishAttempt(attemptId, city, "bootstrap_start",
                ready ? "succeeded" : "failed", ready ? "owner_confirmed" : "owner_failed");
        }
        catch
        {
            ClientExperienceReporter.FinishAttempt(attemptId, city, "bootstrap_start", "failed", "owner_failed");
            ClientExperienceReporter.CaptureRuntimeFailure(city, "application_initialization_fatal");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await StatsSnapshotStore.StartAsync(NavigationManager.ResolveCity());
    }

    public async ValueTask DisposeAsync()
    {
        ClientExperienceCaptureProxy.SetTarget(null);
        await StatsSnapshotStore.StopAsync();
        await ClientExperienceReporter.DisposeAsync();
    }
}
