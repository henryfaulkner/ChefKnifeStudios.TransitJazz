@namespace ChefKnifeStudios.TransitJazz.Client.Shared.Components.Blades
@using ChefKnifeStudios.TransitJazz.Client.Shared.Attributes
@using ChefKnifeStudios.TransitJazz.Client.Shared.Models
@using ChefKnifeStudios.TransitJazz.Client.Shared.Resources
@using ChefKnifeStudios.TransitJazz.Client.Shared.Services
@using Microsoft.Extensions.Localization
@using System.ComponentModel
@using System.Reflection
@inject IStringLocalizer<RouteFilterResources> Localizer
@implements IDisposable

<BladeContainer @ref="_bladeContainer">
    <ContentFragment>
        <p class="settings-title">@Localizer["SettingsTitle"]</p>
        <div class="settings-list">
            @foreach (var prop in typeof(Settings).GetProperties(BindingFlags.Public | BindingFlags.Instance))
            {
                if (prop.GetCustomAttribute<HiddenSettingAttribute>() is not null || prop.PropertyType != typeof(bool))
                {
                    continue;
                }

                var propName = prop.Name;
                var descAttr = prop.GetCustomAttribute<DescriptionAttribute>();
                var resourceKey = descAttr?.Description ?? propName;
                var label = Localizer[resourceKey].Value ?? resourceKey;
                var currentValue = prop.GetValue(_settings) as bool? ?? false;

                @if (propName == nameof(Settings.IsAudioEnabled))
                {
                    <div id="@_audioEnableGestureId">
                        <MatCheckbox TValue="bool"
                                     Value="@currentValue"
                                     ValueChanged="@((bool val) => HandleSettingPressed(propName, val))">
                            @label
                        </MatCheckbox>
                    </div>
                }
                else
                {
                    <MatCheckbox TValue="bool"
                                 Value="@currentValue"
                                 ValueChanged="@((bool val) => HandleSettingPressed(propName, val))">
                        @label
                    </MatCheckbox>
                }
            }
        </div>
        @foreach (var change in _changes.Values.Where(change => change.Status is not (SettingsChangeStatus.Applied or SettingsChangeStatus.Superseded)))
        {
            <p class="settings-change-status" role="status" aria-live="polite">@GetChangeStatusText(change)</p>
        }

        @if (_showDevInstrumentToggles)
        {
            <p class="settings-title">Dev: Instrument Voices</p>
            <div class="settings-list">
                @foreach (var instrumentName in _instrumentNames)
                {
                    var isEnabled = _enabledInstruments.Contains(instrumentName);

                    <MatCheckbox TValue="bool"
                                 Value="@isEnabled"
                                 ValueChanged="@((bool val) => HandleInstrumentTogglePressed(instrumentName, val))">
                        @instrumentName
                    </MatCheckbox>
                }
            </div>
        }
    </ContentFragment>
</BladeContainer>
