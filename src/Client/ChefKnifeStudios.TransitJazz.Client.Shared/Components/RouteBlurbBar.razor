@using ChefKnifeStudios.TransitJazz.Client.Shared.Resources

@if (_blurb is not null)
{
    <div class="route-blurb-bar @(_blurb.IsPlaceholder ? "route-blurb-bar--placeholder" : "")"
         role="region"
         aria-label="@_localizer["RouteBlurbBarAriaLabel"]">
        <div class="route-blurb-bar__tone">@_blurb.ToneDescription</div>
        @if (_blurb.Significance != _blurb.ToneDescription)
        {
            <div class="route-blurb-bar__significance">@_blurb.Significance</div>
        }
    </div>
}
