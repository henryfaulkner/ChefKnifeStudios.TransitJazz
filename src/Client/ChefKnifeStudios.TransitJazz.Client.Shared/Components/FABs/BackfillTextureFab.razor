@using ChefKnifeStudios.TransitJazz.Client.Shared.Models
@using ChefKnifeStudios.TransitJazz.Client.Shared.EventArgs
@using ChefKnifeStudios.TransitJazz.Client.Shared.Resources
@using ChefKnifeStudios.TransitJazz.Client.Shared.Services
@using ChefKnifeStudios.TransitJazz.Client.Shared.Services.JsInterop
@using ChefKnifeStudios.TransitJazz.Client.Core.Services
@using Microsoft.Extensions.Localization
@implements IDisposable
@inject IEventNotificationService EventNotificationService
@inject ISettingsService SettingsService
@inject SettingsChangeController SettingsChangeController
@inject ITransitSynthJsInterop TransitSynth
@inject IStringLocalizer<RouteFilterResources> L

<div class="backfill-texture-fab-container">
    <MatFAB Icon="graphic_eq"
            Mini="true"
            OnClick="OnClick"
            @ref="_button" />
    <MatMenu @ref="_menu" Class="backfill-texture-fab-menu">
        <MatList>
            <MatListItem>
                <MatButton Label="@L["BackfillNoise"]" Mini="true"
                           @onclick="() => Select(BackfillTexture.Noise)"
                           Disabled="@(_current == BackfillTexture.Noise)" />
            </MatListItem>
            <MatListItem>
                <MatButton Label="@L["BackfillPercussion"]" Mini="true"
                           @onclick="() => Select(BackfillTexture.Percussion)"
                           Disabled="@(_current == BackfillTexture.Percussion)" />
            </MatListItem>
        </MatList>
    </MatMenu>
</div>
@if (_lastChange is { } change && change.Status is not (SettingsChangeStatus.Applied or SettingsChangeStatus.Superseded))
{
    <p class="settings-change-status" role="status" aria-live="polite">@GetChangeStatusText(change)</p>
}

@code {
    BackfillTexture _current;
    MatFAB _button;
    BaseMatMenu _menu;
    SettingsChangeOutcome? _lastChange;

    protected override void OnInitialized()
    {
        _current = SettingsService.GetSettings().BackfillTexture;
        EventNotificationService.EventReceived += HandleEventReceived;
    }

    void OnClick(MouseEventArgs e)
    {
        _menu.OpenAsync(_button.Ref);
    }

    async Task Select(BackfillTexture mode)
    {
        _lastChange = await SettingsChangeController.ChangeAsync(
            nameof(Settings.BackfillTexture),
            mode,
            (requested, cancellationToken) => ApplyTextureAsync(requested),
            (previous, cancellationToken) => ApplyTextureAsync(previous));
        var applied = _lastChange.Status is SettingsChangeStatus.Applied or SettingsChangeStatus.AppliedSessionOnly;
        var persisted = _lastChange.IsPersisted;
        _current = SettingsService.GetSettings().BackfillTexture;
        if (applied || _lastChange.Status == SettingsChangeStatus.Superseded)
            _lastChange = null;
        if (applied)
            EventNotificationService.PostEvent(this, new SettingsCommittedEventArgs
            {
                PropertyName = nameof(Settings.BackfillTexture),
                IsPersisted = persisted,
                ChangeOutcome = _lastChange
            });
        StateHasChanged();
    }

    async Task<SettingsEffectResult> ApplyTextureAsync(BackfillTexture texture) =>
        await TransitSynth.SetBackfillTextureAsync(texture.ToString().ToLowerInvariant())
            ? SettingsEffectResult.Success
            : SettingsEffectResult.Failure;

    string GetChangeStatusText(SettingsChangeOutcome outcome) => outcome.Status switch
    {
        SettingsChangeStatus.AppliedSessionOnly => L["ToastSettingsNotSaved"],
        SettingsChangeStatus.MixedState => L["SettingsMixedEffectFailure"],
        _ => L["ToastSettingsApplyFailure"]
    };

    void HandleEventReceived(object sender, IEventArgs e)
    {
        if (e is not SettingsCommittedEventArgs committed) return;
        _current = SettingsService.GetSettings().BackfillTexture;
        if (committed.PropertyName == nameof(Settings.BackfillTexture))
            _lastChange = committed.ChangeOutcome ?? (committed.IsPersisted ? null : _lastChange);
        InvokeAsync(StateHasChanged);
    }

    public void Dispose() => EventNotificationService.EventReceived -= HandleEventReceived;
}
