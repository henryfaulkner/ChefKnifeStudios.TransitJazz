@using System.ComponentModel
@using ChefKnifeStudios.TransitJazz.Client.Core.Services
@using ChefKnifeStudios.TransitJazz.Client.Shared.EventArgs
@using ChefKnifeStudios.TransitJazz.Client.Shared.Resources
@using ChefKnifeStudios.TransitJazz.Client.Shared.Services
@using Microsoft.Extensions.Localization
@implements IDisposable
@inject IEventNotificationService EventNotificationService
@inject IRouteFilterViewModel RouteFilterViewModel
@inject ISettingsService SettingsService
@inject IStringLocalizer<RouteFilterResources> Loc

<div class="transit-running-label @(_isDark ? "transit-running-label--dark" : "")">
    @foreach (var category in RouteFilterViewModel.CategoryOrder)
    {
        var count = RouteFilterViewModel.ActiveCountsByCategory.GetValueOrDefault(category);
        @if (count > 0 || RouteFilterViewModel.HasEmphasisFor(category))
        {
            <div class="transit-running-label__row">
                <MatBody2 class="transit-running-label__icon" data-category="@category"></MatBody2>
                <MatBody2 class="transit-running-label__count">@count</MatBody2>
                <MatBody2 class="transit-running-label__text">@RunningNoun(category)</MatBody2>
            </div>
        }
    }
</div>

<style>
    .transit-running-label {
        display: flex;
        flex-direction: column;
        gap: 2px;
        user-select: none;
        pointer-events: none;
    }

    .transit-running-label__row {
        display: flex;
        gap: 4px;
        align-items: center;
        justify-content: center;
    }

    .transit-running-label__icon {
        display: block;
        height: 12px;
        width: 12px;
        border-radius: 64px;
    }

    /* Neutral default for any category without bespoke styling (D11) */
    .transit-running-label__icon[data-category] {
        background-color: #616161;
    }

    .transit-running-label__icon[data-category="rail"] {
        background-color: #1a237e;
    }

    .transit-running-label__icon[data-category="bus"] {
        background-color: darkgreen;
    }

    .transit-running-label__icon[data-category="streetcar"] {
        background-color: #b71c1c;
    }

    .transit-running-label__count, .transit-running-label__text {
        text-wrap-mode: nowrap;
        color: #171717;
        font-size: 12px;
    }

    .transit-running-label--dark .transit-running-label__count,
    .transit-running-label--dark .transit-running-label__text {
        color: rgba(226, 226, 230, 0.9);
    }

    .transit-running-label--dark .transit-running-label__icon[data-category] {
        background-color: #9e9e9e;
    }

    .transit-running-label--dark .transit-running-label__icon[data-category="rail"] {
        background-color: #7986cb;
    }

    .transit-running-label--dark .transit-running-label__icon[data-category="bus"] {
        background-color: #66bb6a;
    }

    .transit-running-label--dark .transit-running-label__icon[data-category="streetcar"] {
        background-color: #e57373;
    }
</style>

@code {
    bool _isDark;

    protected override void OnInitialized()
    {
        _isDark = SettingsService.GetSettings().IsDarkModeEnabled;
        EventNotificationService.EventReceived += HandleEvent;
        RouteFilterViewModel.PropertyChanged += OnViewModelPropertyChanged;
    }

    void HandleEvent(object sender, IEventArgs e)
    {
        if (e is ThemeChangedEventArgs theme)
        {
            _isDark = theme.IsDarkMode;
            InvokeAsync(StateHasChanged);
        }
    }

    void OnViewModelPropertyChanged(object? sender, PropertyChangedEventArgs e)
    {
        if (e.PropertyName is nameof(IRouteFilterViewModel.ActiveCountsByCategory))
            InvokeAsync(StateHasChanged);
    }

    string RunningNoun(string category)
    {
        var noun = Loc[$"RunningNoun_{category}"];
        return noun.ResourceNotFound
            ? string.Format(Loc["VehiclesRunningTemplate"], Loc[category])
            : noun.Value;
    }

    public void Dispose()
    {
        EventNotificationService.EventReceived -= HandleEvent;
        RouteFilterViewModel.PropertyChanged -= OnViewModelPropertyChanged;
    }
}
