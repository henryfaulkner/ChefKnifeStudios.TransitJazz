@using ChefKnifeStudios.TransitJazz.Client.Shared.EventArgs
@using ChefKnifeStudios.TransitJazz.Client.Shared.Resources
@using ChefKnifeStudios.TransitJazz.Client.Shared.Services
@using ChefKnifeStudios.TransitJazz.Client.Shared.Components
@inject IEventNotificationService EventNotificationService
@inject ISettingsService SettingsService
@inject Microsoft.Extensions.Localization.IStringLocalizer<RouteFilterResources> Loc

<RouteFilterList Model="@ListModel" AriaLabel="@Loc["RouteFilterAccessibleName"]" IsDark="@_isDark"
                 OnToggle="HandleSelect" OnSelectCategory="HandleSelectAll"
                 OnClearCategory="HandleClearSelections" OnHoverRoute="HandleHoverRoute"
                 OnHoverCategory="HandleHoverCategory" />
@if (RouteFilterViewModel.HasSelectedUnavailableRoute)
{
    <p class="route-selection-status" role="status">@Loc["ToastSelectedRouteUnavailable"]</p>
}

@code {
    bool _isDark;

    RouteFilterListModel ListModel => RouteFilterListProjection.FromMap(
        RouteFilterViewModel.RouteItems,
        RouteFilterViewModel.CategoryOrder,
        RouteFilterViewModel.SelectedRouteJoinKeys,
        RouteFilterViewModel.HoveredRouteJoinKeys,
        RouteFilterViewModel.HoveredCategory,
        category => Loc[category].Value,
        category => Loc["RouteSelectCategory", category].Value,
        category => Loc["RouteClearCategory", category].Value);

    void HandleDarkEvent(object sender, IEventArgs e)
    {
        if (e is ThemeChangedEventArgs theme)
        {
            _isDark = theme.IsDarkMode;
            _ = InvokeAsync(StateHasChanged);
        }
    }

    void HandleSelect(string routeKey)
    {
        var item = RouteFilterViewModel.RouteItems.FirstOrDefault(candidate =>
            string.Equals(candidate.RouteJoinKey, routeKey, StringComparison.Ordinal));
        if (item is not null) RouteFilterViewModel.SelectRoute(item);
    }

    void HandleSelectAll(string category) => RouteFilterViewModel.SelectAll(category);
    void HandleClearSelections(string category) => RouteFilterViewModel.ClearSelection(category);

    void HandleHoverRoute(string? routeKey)
    {
        var item = routeKey is null ? null : RouteFilterViewModel.RouteItems.FirstOrDefault(candidate =>
            string.Equals(candidate.RouteJoinKey, routeKey, StringComparison.Ordinal));
        RouteFilterViewModel.SetHoveredRoute(item);
    }

    void HandleHoverCategory(string? category) => RouteFilterViewModel.SetHoveredCategory(category);
}
@using ChefKnifeStudios.TransitJazz.Client.Core.Services
