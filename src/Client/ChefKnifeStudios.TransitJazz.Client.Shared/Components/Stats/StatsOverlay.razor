@using ChefKnifeStudios.TransitJazz.Client.Core.Services
@using ChefKnifeStudios.TransitJazz.Client.Shared.EventArgs
@using ChefKnifeStudios.TransitJazz.Client.Shared.Models
@using ChefKnifeStudios.TransitJazz.Client.Shared.Resources
@using ChefKnifeStudios.TransitJazz.Client.Shared.Services
@using ChefKnifeStudios.TransitJazz.Client.Shared.Services.JsInterop
@using ChefKnifeStudios.TransitJazz.Client.Shared.ViewModels
@using ChefKnifeStudios.TransitJazz.Client.Shared.Components.Charts
@using ChefKnifeStudios.TransitJazz.Client.Shared.Components
@using ChefKnifeStudios.TransitJazz.Shared.Stats
@using System.ComponentModel
@using System.Globalization
@using System.Threading
@using System.Threading.Tasks
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Routing
@implements IDisposable
@inject IEventNotificationService EventNotificationService
@inject ISettingsService SettingsService
@inject IApplicationViewModel ApplicationViewModel
@inject StatsChartText T
@inject StatsSnapshotStore SnapshotStore
@inject NavigationManager NavigationManager

@if (_isOpen)
{
<div class="stats-overlay @(_isDark ? "stats-overlay--dark" : "")"
        role="dialog"
        tabindex="-1"
        aria-label="@T.Get("StatsTitle")"
        @ref="_overlayElement"
        @onkeydown="HandleKeyDown">
    <div class="stats-overlay__scope" role="radiogroup" aria-label="@T.Get("StatsScope")">
        <label>
            <input type="radio" name="stats-scope" value="city" checked="@(_scope == "city")" @onchange='() => ChangeScopeAsync("city")' />
            <span>@CurrentCityName</span>
        </label>
        <label>
            <input type="radio" name="stats-scope" value="all" checked="@(_scope == "all")" @onchange='() => ChangeScopeAsync("all")' />
            <span>@T.Get("StatsAllCities")</span>
        </label>
    </div>

    @if (_scope == "city" && (_hasAcceptedCityOptions || _routeSelection.Count > 0))
    {
        <div class="stats-overlay__routes">
            <MatAccordion Class="">
                <MatExpansionPanel @bind-Expanded="_accordionExpanded">
                    <MatExpansionPanelSummary>
                        <MatExpansionPanelHeader>@T.Get("RoutesLabel")</MatExpansionPanelHeader>
                    </MatExpansionPanelSummary>
                    <MatExpansionPanelDetails>
                        <RouteFilterList CssClass="stats-route-list" Model="@RouteListModel" IsDark="@_isDark"
                                         AriaLabel="@T.Get("RoutesLabel")"
                                         OnToggle="ToggleRouteAsync" OnSelectCategory="SelectRouteCategoryAsync"
                                         OnClearCategory="ClearRouteCategoryAsync" />
                    </MatExpansionPanelDetails>
                </MatExpansionPanel>
            </MatAccordion>
        </div>
    }

    <main class="stats-overlay__content">
        @if (_presentation is { } dashboard)
        {
            @if (dashboard.IsPreviousDay)
            {
                <div class="stats-overlay__previous-day" role="status">
                    <h1>@T.Get("StatsYesterdayDate", dashboard.Snapshot.PreviousDay!.City.LocalDate.ToString("MMMM d, yyyy", CultureInfo.GetCultureInfo("en")))</h1>
                    <p>@T.Get("StatsShowingYesterday")</p>
                </div>
            }
            @if (dashboard.IsHistorical)
            {
                <div class="stats-overlay__historical" role="status" aria-live="polite">
                    @if (dashboard.DailyEvidenceDate is { } dailyDate)
                    {
                        <h1>@T.Get("StatsHistoricalSnapshotDate", FormatDate(dailyDate))</h1>
                        <p>@T.Get("StatsHistoricalSnapshotExplanation")</p>
                    }
                    else
                    {
                        <p>@T.Get("StatsHistoricalAllSnapshotExplanation")</p>
                    }
                </div>
            }
            <section class="stats-overlay__dashboard">
                <SeriesChart Model="@dashboard.Timeline" Title="@T.Get("StatsCumulativeDistance")"
                                State="@(_isLoading ? ChartLoadState.Loading : ChartLoadState.Ready)" IsDark="@_isDark" />
                <section class="stats-overlay__totals" aria-label="@T.Get(dashboard.DailyDistanceHeadingKey)">
                    <article>
                        <h2>@(dashboard.DailyDistanceHeadingKey == "StatsDistanceOnDate"
                            ? T.Get(dashboard.DailyDistanceHeadingKey, FormatDate(dashboard.DailyEvidenceDate))
                            : T.Get(dashboard.DailyDistanceHeadingKey))</h2>
                        <p><strong>@T.Format(ToDouble(dashboard.DailyDistance.Kilometers))</strong> @T.Get("StatsDistanceUnit")</p>
                    </article>
                    <article>
                        <h2>@T.Get("StatsDistanceLast24")</h2>
                        <p><strong>@T.Format(ToDouble(dashboard.Snapshot.Last24Distance.Kilometers))</strong> @T.Get("StatsDistanceUnit")</p>
                    </article>
                    <article class="stats-overlay__reported" aria-labelledby="stats-reported-today-heading">
                        <h2 id="stats-reported-today-heading">@(dashboard.TodayReportedVehicles.HeadingKey == "StatsReportedVehiclesOnDate"
                            ? T.Get(dashboard.TodayReportedVehicles.HeadingKey, FormatDate(dashboard.DailyEvidenceDate))
                            : T.Get(dashboard.TodayReportedVehicles.HeadingKey))</h2>
                        <p class="stats-overlay__reported-count"><strong>@dashboard.TodayReportedVehicles.CountText</strong></p>
                    </article>
                    <article class="stats-overlay__reported" aria-labelledby="stats-reported-last24-heading">
                        <h2 id="stats-reported-last24-heading">@T.Get(dashboard.Last24ReportedVehicles.HeadingKey)</h2>
                        <p class="stats-overlay__reported-count"><strong>@dashboard.Last24ReportedVehicles.CountText</strong></p>
                    </article>
                </section>
                <BubbleChart Model="@dashboard.Bubbles" Title="@T.Get(dashboard.Snapshot.Selection.Scope == "city" ? "StatsRouteActivity" : "StatsCityActivity")"
                                XAxisTitle="@T.Get("StatsBubbleX")" YAxisTitle="@T.Get("StatsBubbleY")"
                                State="@(_isLoading ? ChartLoadState.Loading : ChartLoadState.Ready)" IsDark="@_isDark" />
                <PieChart Model="@dashboard.CategoryPie" Title="@T.Get("StatsCategoryShares")"
                            State="@(_isLoading ? ChartLoadState.Loading : ChartLoadState.Ready)" IsDark="@_isDark" />
            </section>
            <p class="stats-overlay__snapshot-updated">@T.Get("StatsSnapshotUpdatedAt", SnapshotUpdatedAtText)</p>
        }
        @if (_recoveryNotice)
        {
            <p class="stats-overlay__recovery" role="status" aria-live="polite">@T.Get("StatsRefreshRecovered")</p>
        }
        @if (_presentation is not null)
        {
            @if (_isStale && _errorCode is not null)
            {
                <div class="stats-overlay__error" role="status" aria-live="polite">
                    <p>@T.Get("StatsStale")</p>
                    <p>@T.Get("StatsSnapshotUpdatedAt", SnapshotUpdatedAtText)</p>
                    <p>@T.Get(StatsOverlayErrorResources.ResourceKey(_errorCode))</p>
                    <button type="button" @onclick="RetryAsync">@T.Get("StatsRetry")</button>
                </div>
            }
            else if (_isStale && !_isHistorical)
            {
                <div class="stats-overlay__overdue" role="status" aria-live="polite">
                    <p>@T.Get("StatsOverdueNotice")</p>
                    <p>@T.Get("StatsSnapshotUpdatedAt", SnapshotUpdatedAtText)</p>
                    <button type="button" @onclick="RetryAsync">@T.Get("StatsRetry")</button>
                </div>
            }
        }
        else if (_isLoading)
        {
            <div class="app-loader stats-overlay__loader" role="status" aria-live="polite">
                <div class="app-loader__ring" aria-hidden="true"></div>
                <span class="app-loader__label">loading...</span>
            </div>
        }
        else if (_errorCode is not null)
        {
            <div class="stats-overlay__error" role="status" aria-live="polite">
                <p>@T.Get(StatsOverlayErrorResources.ResourceKey(_errorCode))</p>
                <button type="button" @onclick="RetryAsync">@T.Get("StatsRetry")</button>
            </div>
        }
        else
        {
            <div class="stats-overlay__unavailable" role="status">
                <p>@T.Get("StatsNoMatchingSnapshot")</p>
                <button type="button" @onclick="RetryAsync">@T.Get("StatsRetry")</button>
            </div>
        }
    </main>
    <OverlayFooter IsDark="@_isDark" />
</div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    bool _isOpen;
    bool _isDark;
    bool _accordionExpanded;
    bool _disposed;
    ElementReference _overlayElement;
    bool _focusOnRender;
    readonly StatsOverlayAcceptedSnapshotState _acceptedSnapshot = new();
    StatsOverlayResponse? _snapshot => _acceptedSnapshot.Current?.Snapshot;
    StatsOverlayPresentation? _presentation => _acceptedSnapshot.Current?.Presentation;
    bool _isStale => _acceptedSnapshot.Current?.IsStale == true;
    bool _isHistorical => _acceptedSnapshot.Current?.Presentation.IsHistorical == true;
    IReadOnlyList<StatsRouteOption> _routeOptions = [];
    readonly StatsRouteSelectionState _routeSelection = new();
    CancellationTokenSource? _sessionCancellation;
    CancellationTokenSource? _selectionDebounceCancellation;
    StatsSelection? _subscribedSelection;
    string _citySlug = string.Empty;
    string CurrentCityName => T.Get(_citySlug switch
    {
        "atlanta" => "StatsCityAtlanta",
        "boston" => "StatsCityBoston",
        "denver" => "StatsCityDenver",
        "new-york-city" => "StatsCityNewYorkCity",
        "philadelphia" => "StatsCityPhiladelphia",
        "toronto" => "StatsCityToronto",
        "washington-dc" => "StatsCityWashingtonDc",
        "seattle" => "StatsCitySeattle",
        _ => "StatsCityUnknown"
    });
    string _scope = "city";
    string? _errorCode;
    bool _recoveryNotice;
    StatsSnapshotFreshness _freshness = new(false, false, false, false);
    long _generation;
    bool _isLoading;
    bool _hasAcceptedCityOptions;

    protected override void OnInitialized()
    {
        _isDark = SettingsService.GetSettings().IsDarkModeEnabled;
        _citySlug = NavigationManager.ResolveCity();
        EventNotificationService.EventReceived += HandleEvent;
        NavigationManager.LocationChanged += HandleLocationChanged;
        ApplicationViewModel.PropertyChanged += HandleRouteMetadataChanged;
    }

    protected override void OnParametersSet()
    {
        if (_isOpen == IsOpen) return;
        _isOpen = IsOpen;
        _focusOnRender = _isOpen;
        if (_isOpen) _ = InvokeAsync(StartNewSessionAsync);
        else CloseSession();
    }

    void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        if (_disposed) return;
        var city = NavigationManager.ResolveCity();
        if (string.Equals(city, _citySlug, StringComparison.Ordinal)) return;
        _citySlug = city;
        if (_isOpen) _ = InvokeAsync(StartNewSessionAsync);
    }

    Task CloseAsync() => OnClose.InvokeAsync();

    void HandleRouteMetadataChanged(object? sender, PropertyChangedEventArgs args)
    {
        if (!_disposed && _isOpen && args.PropertyName == nameof(IApplicationViewModel.RoutesLoaded))
            _ = InvokeAsync(RefreshPresentation);
    }

    void RefreshPresentation()
    {
        if (_disposed) return;
        if (_isOpen && _snapshot is { } snapshot)
            _acceptedSnapshot.TryReplacePresentation(BuildPresentation(snapshot));
        StateHasChanged();
    }

    Task HandleKeyDown(KeyboardEventArgs args) => args.Key == "Escape" ? CloseAsync() : Task.CompletedTask;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed) return;
        if (_focusOnRender && _isOpen && !_disposed)
        {
            _focusOnRender = false;
            await _overlayElement.FocusAsync();
        }
    }

    void HandleEvent(object sender, IEventArgs args)
    {
        if (_disposed) return;
        if (args is ThemeChangedEventArgs theme)
        {
            _isDark = theme.IsDarkMode;
            _ = InvokeAsync(RefreshPresentation);
        }
    }

    async Task StartNewSessionAsync()
    {
        if (_disposed || !_isOpen) return;
        CloseSession();
        _sessionCancellation = new CancellationTokenSource();
        _citySlug = NavigationManager.ResolveCity();
        _scope = "city";
        _routeSelection.Clear();
        _routeOptions = [];
        _hasAcceptedCityOptions = false;
        _acceptedSnapshot.Clear();
        _errorCode = null;
        _recoveryNotice = false;
        _freshness = new(false, false, false, false);
        _isLoading = false;
        _generation++;
        var selection = CurrentSelection;
        SnapshotStore.SetOverlaySelection(selection);
        SubscribeToSelection(selection);
        var evidence = SnapshotStore.TryGet(selection);
        ApplyStoreState(selection, evidence, rebuildPresentation: true);
        var decision = StatsOverlayOpenPolicy.Evaluate(evidence);
        SnapshotStore.RecordOverlayOpened(evidence, decision.ShowInitialLoader);
        _isLoading = decision.ShowInitialLoader && evidence?.ProblemCode is null;
        await InvokeAsync(StateHasChanged);
        if (decision.ShouldRequest)
            await EnsureSelectionAsync(selection, _generation, retainSnapshot: _snapshot is not null);
    }

    void CloseSession()
    {
        _generation++;
        UnsubscribeFromSelection();
        SnapshotStore.SetOverlaySelection(null);
        CancelSelectionDebounce();
        _sessionCancellation?.Cancel();
        _sessionCancellation?.Dispose();
        _sessionCancellation = null;
        _acceptedSnapshot.Clear();
        _routeOptions = [];
        _hasAcceptedCityOptions = false;
        _routeSelection.Clear();
        _errorCode = null;
        _recoveryNotice = false;
        _freshness = new(false, false, false, false);
        _isLoading = false;
    }

    async Task ChangeScopeAsync(string scope)
    {
        if (!_isOpen || scope is not ("city" or "all") || scope == _scope) return;
        _scope = scope;
        _routeSelection.Clear();
        _routeOptions = [];
        _hasAcceptedCityOptions = false;
        CancelSelectionDebounce();
        var selection = CurrentSelection;
        SwitchStoreSelection(selection);
        _acceptedSnapshot.Clear();
        _errorCode = null;
        _recoveryNotice = false;
        ApplyStoreState(selection, SnapshotStore.TryGet(selection), rebuildPresentation: true);
        var decision = StatsOverlayOpenPolicy.Evaluate(SnapshotStore.TryGet(selection));
        _isLoading = decision.ShowInitialLoader && _errorCode is null;
        if (_isLoading) SnapshotStore.RecordLoader();
        var generation = ++_generation;
        await InvokeAsync(StateHasChanged);
        if (decision.ShouldRequest)
            await EnsureSelectionAsync(selection, generation, retainSnapshot: _snapshot is not null);
    }

    async Task RetryAsync()
    {
        var generation = _generation;
        await EnsureSelectionAsync(CurrentSelection, generation, retainSnapshot: _snapshot is not null);
    }

    IReadOnlyList<StatsRouteOption> CurrentRouteOptions => _routeSelection.MergeOptions(
        _routeOptions, _citySlug, _presentation?.DailyDistance.Coverage.SelectedRouteCoverage);

    RouteFilterListModel RouteListModel => RouteFilterListProjection.FromStats(
        CurrentRouteOptions,
        _routeSelection.SelectedKeys,
        category => T.Get(StatsOverlayProjection.CategoryResourceKey(category)),
        option => option.AvailabilityReason is { } reason ? T.Get(ChartLocalization.ReasonKey(reason)) : null,
        option => option.CategoryChanged ? T.Get("StatsCategoryChanged") : null,
        (_, label) => T.Get("StatsSelectCategory", label),
        (_, label) => T.Get("StatsClearCategory", label),
        T.Get("StatsNoRoutes"),
        ApplicationViewModel.RouteShapes,
        isDark: _isDark);

    Task ToggleRouteAsync(string routeJoinKey)
    {
        if (!_isOpen || _scope != "city") return Task.CompletedTask;
        _routeSelection.Toggle(routeJoinKey);
        return ScheduleSelectionRequestAsync();
    }

    Task SelectRouteCategoryAsync(string categoryKey)
    {
        if (!_isOpen || _scope != "city") return Task.CompletedTask;
        _routeSelection.SelectCategory(categoryKey, CurrentRouteOptions);
        return ScheduleSelectionRequestAsync();
    }

    Task ClearRouteCategoryAsync(string categoryKey)
    {
        if (!_isOpen || _scope != "city") return Task.CompletedTask;
        _routeSelection.ClearCategory(categoryKey, CurrentRouteOptions);
        return ScheduleSelectionRequestAsync();
    }

    async Task ScheduleSelectionRequestAsync()
    {
        CancelSelectionDebounce();
        var sessionToken = _sessionCancellation?.Token ?? CancellationToken.None;
        if (sessionToken.IsCancellationRequested) return;
        var debounce = CancellationTokenSource.CreateLinkedTokenSource(sessionToken);
        _selectionDebounceCancellation = debounce;
        var generation = ++_generation;
        var selection = CurrentSelection;
        SwitchStoreSelection(selection);
        _acceptedSnapshot.Clear();
        _errorCode = null;
        _recoveryNotice = false;
        var evidence = SnapshotStore.TryGet(selection);
        ApplyStoreState(selection, evidence, rebuildPresentation: true);
        _isLoading = evidence?.Snapshot is null && evidence?.ProblemCode is null;
        if (_isLoading) SnapshotStore.RecordLoader();
        await InvokeAsync(StateHasChanged);
        try
        {
            await EnsureSelectionAsync(selection, generation, retainSnapshot: _snapshot is not null,
                debounceFilteredSelection: true, debounce.Token);
        }
        catch (OperationCanceledException) when (debounce.IsCancellationRequested) { }
        finally
        {
            if (ReferenceEquals(_selectionDebounceCancellation, debounce))
                _selectionDebounceCancellation = null;
            debounce.Dispose();
        }
    }

    void CancelSelectionDebounce()
    {
        var debounce = _selectionDebounceCancellation;
        _selectionDebounceCancellation = null;
        debounce?.Cancel();
    }

    async Task EnsureSelectionAsync(
        StatsSelection selection,
        long generation,
        bool retainSnapshot,
        bool debounceFilteredSelection = false,
        CancellationToken requestToken = default)
    {
        if (_disposed || !_isOpen || _sessionCancellation is null || generation != _generation) return;
        _isLoading = !retainSnapshot || _snapshot is null;
        await InvokeAsync(StateHasChanged);
        try
        {
            var token = requestToken.CanBeCanceled ? requestToken : _sessionCancellation.Token;
            if (debounceFilteredSelection)
                await SnapshotStore.EnsureDisplayedSelectionAsync(selection, token);
            else
                await SnapshotStore.EnsureRequestedAsync(selection, token);
        }
        catch (OperationCanceledException) when (_sessionCancellation?.IsCancellationRequested == true)
        {
        }
        catch
        {
            if (!_disposed && generation == _generation)
            {
                _errorCode = "dependency_unavailable";
                _acceptedSnapshot.MarkStale();
            }
        }
        finally
        {
            if (!_disposed && generation == _generation)
            {
                var latest = SnapshotStore.TryGet(selection);
                if (latest is not null) ApplyStoreState(selection, latest, rebuildPresentation: false);
                _isLoading = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    StatsSelection CurrentSelection => StatsSnapshotPolicy.NormalizeSelection(new(
        _scope,
        _scope == "city" ? _citySlug : null,
        _scope == "city" ? _routeSelection.SelectedKeys.ToArray() : []));

    void SwitchStoreSelection(StatsSelection selection)
    {
        UnsubscribeFromSelection();
        SnapshotStore.SetOverlaySelection(selection);
        SubscribeToSelection(selection);
    }

    void SubscribeToSelection(StatsSelection selection)
    {
        _subscribedSelection = selection;
        SnapshotStore.StateChanged += HandleStoreStateChanged;
    }

    void UnsubscribeFromSelection()
    {
        if (_subscribedSelection is null) return;
        SnapshotStore.StateChanged -= HandleStoreStateChanged;
        _subscribedSelection = null;
    }

    void HandleStoreStateChanged(StatsSelection selection, StatsSnapshotState state)
    {
        if (_disposed || !_isOpen || _subscribedSelection is not { } subscribed
            || !SameSelection(selection, subscribed)) return;
        _ = InvokeAsync(() =>
        {
            if (_disposed || !_isOpen || !SameSelection(selection, CurrentSelection)) return;
            ApplyStoreState(selection, SnapshotStore.TryGet(selection) ?? state, rebuildPresentation: true);
            _isLoading = false;
            StateHasChanged();
        });
    }

    void ApplyStoreState(StatsSelection selection, StatsSnapshotState? state, bool rebuildPresentation)
    {
        if (state is null)
        {
            _freshness = new(false, false, false, false);
            _errorCode = null;
            _recoveryNotice = false;
            if (rebuildPresentation) _acceptedSnapshot.Clear();
            return;
        }

        var previousErrorCode = _errorCode;
        _freshness = state.Freshness;
        _errorCode = state.ProblemCode;
        if (_errorCode is not null) _recoveryNotice = false;
        else if (previousErrorCode is not null && state.Snapshot is not null) _recoveryNotice = true;
        if (state.Snapshot is not { } snapshot)
        {
            if (_snapshot is not null) _acceptedSnapshot.MarkStale();
            return;
        }

        if (_snapshot is not null && ReferenceEquals(_snapshot, snapshot))
        {
            if (rebuildPresentation && _presentation?.IsHistorical != state.Freshness.IsHistorical)
                _acceptedSnapshot.TryReplacePresentation(BuildPresentation(snapshot));
            if (state.Freshness.IsStale || state.ProblemCode is not null) _acceptedSnapshot.MarkStale();
            else _acceptedSnapshot.MarkFresh();
            return;
        }

        if (!rebuildPresentation || !_isOpen) return;
        try
        {
            var presentation = BuildPresentation(snapshot);
            if (_acceptedSnapshot.TryAccept(_generation, _generation, snapshot, presentation,
                    selection.Scope, selection.CitySlug, selection.RouteJoinKeys))
            {
                _routeOptions = selection.Scope == "city" ? snapshot.RouteOptions : [];
                _hasAcceptedCityOptions = selection.Scope == "city";
                if (state.Freshness.IsStale || state.ProblemCode is not null) _acceptedSnapshot.MarkStale();
            }
            else
            {
                _errorCode = "invalid_response";
                _acceptedSnapshot.MarkStale();
            }
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or NullReferenceException)
        {
            _errorCode = "invalid_response";
            _acceptedSnapshot.MarkStale();
        }
    }

    static bool SameSelection(StatsSelection left, StatsSelection right) =>
        string.Equals(left.Scope, right.Scope, StringComparison.Ordinal)
        && string.Equals(left.CitySlug, right.CitySlug, StringComparison.Ordinal)
        && left.RouteJoinKeys.SequenceEqual(right.RouteJoinKeys, StringComparer.Ordinal);

    StatsOverlayPresentation BuildPresentation(StatsOverlayResponse snapshot) =>
        StatsOverlayProjection.Build(snapshot, key => T.Get(key), ApplicationViewModel.RouteShapes,
            isDark: _isDark, isHistorical: _freshness.IsHistorical);

    string SnapshotUpdatedAtText => _snapshot?.GeneratedAtUtc.ToString(
        "MMMM d, yyyy h:mm:ss tt 'UTC'", CultureInfo.GetCultureInfo("en")) ?? string.Empty;

    static string FormatDate(DateOnly? date) => date?.ToString("MMMM d, yyyy", CultureInfo.GetCultureInfo("en"))
        ?? string.Empty;

    static double? ToDouble(decimal? value) => value is { } number ? (double)number : null;

    public void Dispose()
    {
        if (_disposed) return;
        _disposed = true;
        ApplicationViewModel.PropertyChanged -= HandleRouteMetadataChanged;
        CloseSession();
        EventNotificationService.EventReceived -= HandleEvent;
        NavigationManager.LocationChanged -= HandleLocationChanged;
    }
}
