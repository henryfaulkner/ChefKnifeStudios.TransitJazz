@using ChefKnifeStudios.TransitJazz.Client.Core.Services
@using ChefKnifeStudios.TransitJazz.Client.Shared.EventArgs
@using ChefKnifeStudios.TransitJazz.Client.Shared.Models
@using ChefKnifeStudios.TransitJazz.Client.Shared.Resources
@using ChefKnifeStudios.TransitJazz.Client.Shared.Services
@using ChefKnifeStudios.TransitJazz.Client.Shared.Services.JsInterop
@using ChefKnifeStudios.TransitJazz.Client.Shared.ViewModels
@using ChefKnifeStudios.TransitJazz.Client.Shared.Components.Charts
@using ChefKnifeStudios.TransitJazz.Client.Shared.Components
@using ChefKnifeStudios.TransitJazz.Client.Core.Services.EndpointsServices
@using ChefKnifeStudios.TransitJazz.Shared.Stats
@using System.Globalization
@using System.ComponentModel
@using System.Net
@using System.Threading
@using System.Threading.Tasks
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Routing
@implements IAsyncDisposable
@inject IEventNotificationService EventNotificationService
@inject ISettingsService SettingsService
@inject IApplicationViewModel ApplicationViewModel
@inject StatsChartText T
@inject IStatsEndpointsService StatsEndpoints
@inject IPageVisibilityJsInterop PageVisibility
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<dialog class="stats-overlay @(_isDark ? "stats-overlay--dark" : "")"
        aria-labelledby="stats-overlay-title"
        aria-describedby="stats-overlay-description"
        @ref="_dialogElement"
        @onkeydown="HandleKeyDown">
    <header class="stats-overlay__header">
        <h1 id="stats-overlay-title">@T.Get("StatsTitle")</h1>
        <div class="stats-overlay__scope" role="group" aria-label="@T.Get("StatsScope")">
            <button type="button" aria-pressed="@(_scope == "city" ? "true" : "false")" @onclick='() => ChangeScopeAsync("city")'>@T.Get("StatsCurrentCity")</button>
            <button type="button" aria-pressed="@(_scope == "all" ? "true" : "false")" @onclick='() => ChangeScopeAsync("all")'>@T.Get("StatsAllCities")</button>
        </div>
        <button type="button" class="stats-overlay__close" autofocus aria-label="@T.Get("StatsClose")" @onclick="CloseAsync">
            <span aria-hidden="true">&#215;</span>
        </button>
    </header>


    <main class="stats-overlay__content">
        <p id="stats-overlay-description" class="stats-overlay__notice">@T.Get("StatsHelp")</p>
        @if (_selectionPending)
        {
            <p class="stats-overlay__status" role="status">@T.Get("StatsSelectionUpdating")</p>
        }
        @if (_isRefreshing)
        {
            <p class="stats-overlay__status" role="status">@T.Get("StatsRefreshing")</p>
        }
        else if (_isStale)
        {
            <p class="stats-overlay__status" role="status">@T.Get("StatsStale")</p>
        }
        @if (_presentation is { } presentation)
        {
            <section class="stats-overlay__meta" aria-label="@T.Get("StatsOverview")">
                <dl><dt>@T.Get("StatsScope")</dt><dd>@ScopeDescription(presentation.Snapshot)</dd></dl>
                <dl><dt>@T.Get("StatsLocalDate")</dt><dd>@string.Join(", ", presentation.Snapshot.Cities.Select(city => $"{CityName(city)}: {FormatLocalDate(city.LocalDate)}"))</dd></dl>
                <dl><dt>@T.Get("StatsTimeZone")</dt><dd>@string.Join(", ", presentation.Snapshot.Cities.Select(city => $"{CityName(city)}: {city.TimeZone}"))</dd></dl>
                <dl><dt>@T.Get("StatsGeneratedAt")</dt><dd>@FormatUtc(presentation.Snapshot.GeneratedAtUtc)</dd></dl>
                <dl><dt>@T.Get("StatsCutoff")</dt><dd>@FormatUtc(presentation.Snapshot.CutoffUtc)</dd></dl>
            </section>
        }
        <div class="stats-overlay__workspace @(_scope == "all" ? "stats-overlay__workspace--all" : "")">
            @if (_scope == "city" && (_hasAcceptedCityOptions || _routeSelection.Count > 0))
            {
                <MatAccordion Class="">
                    <MatExpansionPanel @bind-Expanded="_accordionExpanded">
                        <MatExpansionPanelSummary>
                            <MatExpansionPanelHeader>@T.Get("RoutesLabel")</MatExpansionPanelHeader>
                        </MatExpansionPanelSummary>
                        <MatExpansionPanelDetails>
                            <RouteFilterList CssClass="stats-route-list" Model="@RouteListModel" IsDark="@_isDark"
                                             AriaLabel="@T.Get("RoutesLabel")" HelpText="@T.Get("StatsRouteSelectorHelp")"
                                             SelectedSummary="@T.Get("StatsRoutesSelected", _routeSelection.Count)"
                                             SelectAllText="@T.Get("StatsSelectAllRoutes")" ClearAllText="@T.Get("StatsClearAllRoutes")"
                                             OnToggle="ToggleRouteAsync" OnSelectCategory="SelectRouteCategoryAsync"
                                             OnClearCategory="ClearRouteCategoryAsync" OnSelectAll="SelectAllRoutesAsync"
                                             OnClearAll="ClearAllRoutesAsync" />
                        </MatExpansionPanelDetails>
                    </MatExpansionPanel>
                </MatAccordion>
            }
            @if (_presentation is { } dashboard)
            {
                <section class="stats-overlay__dashboard">
                    <PieChart Model="@dashboard.CategoryPie" Title="@T.Get("StatsCategoryShares")"
                              Definition="@T.Get("StatsTransfers")" PeriodLabel="@T.Get("StatsDistanceToday")"
                              State="@(_isLoading ? ChartLoadState.Loading : ChartLoadState.Ready)" IsDark="@_isDark" />
                    <section class="stats-overlay__totals" aria-label="@T.Get("StatsDistanceToday")">
                        <article>
                            <h2>@T.Get("StatsDistanceToday")</h2>
                            <p><strong>@T.Format(ToDouble(dashboard.Snapshot.TodayDistance.Kilometers))</strong> @T.Get("StatsDistanceUnit")</p>
                            <span>@T.Get(ChartLocalization.CoverageKey(dashboard.Snapshot.TodayDistance.Coverage.State))</span>
                            <p>@CoverageSummary(dashboard.Snapshot.TodayDistance.Coverage, dashboard.Snapshot.TodayDistance.Kilometers)</p>
                        </article>
                        <article>
                            <h2>@T.Get("StatsDistanceLast24")</h2>
                            <p><strong>@T.Format(ToDouble(dashboard.Snapshot.Last24Distance.Kilometers))</strong> @T.Get("StatsDistanceUnit")</p>
                            <span>@T.Get(ChartLocalization.CoverageKey(dashboard.Snapshot.Last24Distance.Coverage.State))</span>
                            <p>@CoverageSummary(dashboard.Snapshot.Last24Distance.Coverage, dashboard.Snapshot.Last24Distance.Kilometers)</p>
                        </article>
                    </section>
                    <BubbleChart Model="@dashboard.Bubbles" Title="@T.Get(dashboard.Snapshot.Selection.Scope == "city" ? "StatsRouteActivity" : "StatsCityActivity")"
                                 Definition="@BubbleDefinition"
                                 PeriodLabel="@T.Get("StatsDistanceToday")" XAxisTitle="@T.Get("StatsBubbleX")" YAxisTitle="@T.Get("StatsBubbleY")"
                                 State="@(_isLoading ? ChartLoadState.Loading : ChartLoadState.Ready)" IsDark="@_isDark" />
                    <SeriesChart Model="@dashboard.Timeline" Title="@T.Get("StatsCumulativeDistance")"
                                 Definition="@T.Get("StatsKnownSubtotal")" PeriodLabel="@T.Get("StatsDistanceToday")"
                                 State="@(_isLoading ? ChartLoadState.Loading : ChartLoadState.Ready)" IsDark="@_isDark" />
                </section>
            }
        </div>
        @if (_presentation is { } accepted)
        {
            @if (_isStale && _errorCode is not null)
            {
                <div class="stats-overlay__error" role="alert">
                    <p>@T.Get(StatsOverlayErrorResources.ResourceKey(_errorCode))</p>
                    <button type="button" disabled="@_retryPolicy.IsCoolingDown(DateTimeOffset.UtcNow)" @onclick="RetryAsync">@T.Get("StatsRetry")</button>
                </div>
            }
            @if (accepted.Snapshot.Selection.Scope == "all")
            {
                <p class="stats-overlay__freshness">@T.Get("StatsScopeAll")</p>
            }
            @foreach (var warning in accepted.Snapshot.Warnings)
            {
                <p class="stats-overlay__warning">@T.Get(WarningKey(warning))</p>
            }
            <p class="stats-overlay__freshness">@T.Get("StatsFreshness")</p>
        }
        else if (_isLoading)
        {
            <p class="stats-overlay__status" role="status">@T.Get("StatsLoading")</p>
        }
        else if (_errorCode is not null)
        {
            <div class="stats-overlay__error" role="alert">
                <p>@T.Get(StatsOverlayErrorResources.ResourceKey(_errorCode))</p>
                <button type="button" disabled="@_retryPolicy.IsCoolingDown(DateTimeOffset.UtcNow)" @onclick="RetryAsync">@T.Get("StatsRetry")</button>
            </div>
        }
    </main>
</dialog>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    bool _isOpen;
    bool _isDark;
    bool _accordionExpanded;
    bool _disposed;
    ElementReference _dialogElement;
    IJSObjectReference? _dialogModule;
    readonly StatsOverlayAcceptedSnapshotState _acceptedSnapshot = new();
    StatsOverlayResponse? _snapshot => _acceptedSnapshot.Current?.Snapshot;
    StatsOverlayPresentation? _presentation => _acceptedSnapshot.Current?.Presentation;
    bool _isStale => _acceptedSnapshot.Current?.IsStale == true;
    IReadOnlyList<StatsRouteOption> _routeOptions = [];
    readonly StatsRouteSelectionState _routeSelection = new();
    CancellationTokenSource? _sessionCancellation;
    readonly StatsOverlayRefreshLoopState _refreshLoop = new();
    CancellationTokenSource? _requestCancellation;
    CancellationTokenSource? _selectionDebounceCancellation;
    readonly StatsOverlayRequestGate _requestGate = new();
    readonly StatsOverlayRetryPolicy _retryPolicy = new();
    string _citySlug = string.Empty;
    string _scope = "city";
    string? _errorCode;
    DateTimeOffset? _lastSuccessAtUtc;
    long _generation;
    bool _isLoading;
    bool _isRefreshing;
    bool _isHidden;
    bool _needsVisibleRefresh;
    bool _selectionPending;
    bool _hasAcceptedCityOptions;

    protected override void OnInitialized()
    {
        _isDark = SettingsService.GetSettings().IsDarkModeEnabled;
        _citySlug = NavigationManager.ResolveCity();
        EventNotificationService.EventReceived += HandleEvent;
        NavigationManager.LocationChanged += HandleLocationChanged;
        PageVisibility.VisibilityChanged += HandlePageVisibilityChanged;
        ApplicationViewModel.PropertyChanged += HandleRouteMetadataChanged;
    }

    protected override void OnParametersSet()
    {
        if (_isOpen == IsOpen) return;
        _isOpen = IsOpen;
        if (_isOpen) _ = InvokeAsync(StartNewSessionAsync);
        else CloseSession();
    }

    void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        if (_disposed) return;
        var city = NavigationManager.ResolveCity();
        if (string.Equals(city, _citySlug, StringComparison.Ordinal)) return;
        _citySlug = city;
        if (_isOpen) _ = InvokeAsync(StartNewSessionAsync);
    }

    Task CloseAsync() => OnClose.InvokeAsync();

    void HandleRouteMetadataChanged(object? sender, PropertyChangedEventArgs args)
    {
        if (!_disposed && _isOpen && args.PropertyName == nameof(IApplicationViewModel.RoutesLoaded))
            _ = InvokeAsync(RefreshPresentation);
    }

    void RefreshPresentation()
    {
        if (_disposed) return;
        if (_isOpen && _snapshot is { } snapshot)
            _acceptedSnapshot.TryReplacePresentation(BuildPresentation(snapshot));
        StateHasChanged();
    }

    Task HandleKeyDown(KeyboardEventArgs args) => args.Key == "Escape" ? CloseAsync() : Task.CompletedTask;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed) return;
        if (firstRender)
        {
            try
            {
                _isHidden = await PageVisibility.GetHiddenAsync();
                if (_isHidden)
                {
                    _needsVisibleRefresh = true;
                    CancelActiveRequest();
                }
            }
            catch (JSException) { }
        }
        if (_isOpen && _dialogModule is null)
        {
            var module = await JS.InvokeAsync<IJSObjectReference>(
                "import", "./_content/ChefKnifeStudios.TransitJazz.Client.Shared/js/stats-dialog.js");
            if (_disposed)
            {
                await module.DisposeAsync();
                return;
            }
            _dialogModule = module;
        }
        if (_dialogModule is not null)
            await _dialogModule.InvokeVoidAsync("setOpen", _dialogElement, _isOpen);
    }

    void HandleEvent(object sender, IEventArgs args)
    {
        if (_disposed) return;
        if (args is ThemeChangedEventArgs theme)
        {
            _isDark = theme.IsDarkMode;
            _ = InvokeAsync(RefreshPresentation);
        }
    }

    async Task StartNewSessionAsync()
    {
        if (_disposed || !_isOpen) return;
        CloseSession();
        _sessionCancellation = new CancellationTokenSource();
        _citySlug = NavigationManager.ResolveCity();
        _scope = "city";
        _routeSelection.Clear();
        _routeOptions = [];
        _hasAcceptedCityOptions = false;
        _acceptedSnapshot.Clear();
        _errorCode = null;
        _retryPolicy.Reset();
        _isLoading = true;
        _isRefreshing = false;
        _selectionPending = false;
        _needsVisibleRefresh = false;
        _generation++;
        _requestGate.InvalidatePending();
        _lastSuccessAtUtc = null;
        var generation = _generation;
        await InvokeAsync(StateHasChanged);
        StartRefreshLoop();
        await RequestSnapshotAsync(generation, retainSnapshot: false);
    }

    void CloseSession()
    {
        StopRefreshLoop();
        _generation++;
        _requestGate.InvalidatePending();
        CancelSelectionDebounce();
        CancelActiveRequest();
        _sessionCancellation?.Cancel();
        _sessionCancellation?.Dispose();
        _sessionCancellation = null;
        _acceptedSnapshot.Clear();
        _routeOptions = [];
        _hasAcceptedCityOptions = false;
        _routeSelection.Clear();
        _errorCode = null;
        _isLoading = false;
        _isRefreshing = false;
        _selectionPending = false;
        _needsVisibleRefresh = false;
    }

    async Task ChangeScopeAsync(string scope)
    {
        if (!_isOpen || scope is not ("city" or "all") || scope == _scope) return;
        _scope = scope;
        _routeSelection.Clear();
        _routeOptions = [];
        _hasAcceptedCityOptions = false;
        _selectionPending = false;
        CancelSelectionDebounce();
        CancelActiveRequest();
        _acceptedSnapshot.Clear();
        _isLoading = true;
        _isRefreshing = false;
        var generation = ++_generation;
        await InvokeAsync(StateHasChanged);
        await RequestSnapshotAsync(generation, retainSnapshot: false);
    }

    async Task RetryAsync()
    {
        if (_retryPolicy.IsCoolingDown(DateTimeOffset.UtcNow)) return;
        var generation = _generation;
        await RequestSnapshotAsync(generation, retainSnapshot: _snapshot is not null);
    }

    IReadOnlyList<StatsRouteOption> CurrentRouteOptions => _routeSelection.MergeOptions(
        _routeOptions, _citySlug, _snapshot?.TodayDistance.Coverage.SelectedRouteCoverage);

    RouteFilterListModel RouteListModel => RouteFilterListProjection.FromStats(
        CurrentRouteOptions,
        _routeSelection.SelectedKeys,
        category => T.Get(StatsOverlayProjection.CategoryResourceKey(category)),
        option => option.AvailabilityReason is { } reason ? T.Get(ChartLocalization.ReasonKey(reason)) : null,
        option => option.CategoryChanged ? T.Get("StatsCategoryChanged") : null,
        (_, label) => T.Get("StatsSelectCategory", label),
        (_, label) => T.Get("StatsClearCategory", label),
        T.Get("StatsNoRoutes"),
        ApplicationViewModel.RouteShapes,
        isDark: _isDark);

    Task ToggleRouteAsync(string routeJoinKey)
    {
        if (!_isOpen || _scope != "city") return Task.CompletedTask;
        _routeSelection.Toggle(routeJoinKey);
        return ScheduleSelectionRequestAsync();
    }

    Task SelectAllRoutesAsync()
    {
        if (!_isOpen || _scope != "city") return Task.CompletedTask;
        _routeSelection.SelectAll(CurrentRouteOptions);
        return ScheduleSelectionRequestAsync();
    }

    Task ClearAllRoutesAsync()
    {
        if (!_isOpen || _scope != "city") return Task.CompletedTask;
        _routeSelection.Clear();
        return ScheduleSelectionRequestAsync();
    }

    Task SelectRouteCategoryAsync(string categoryKey)
    {
        if (!_isOpen || _scope != "city") return Task.CompletedTask;
        _routeSelection.SelectCategory(categoryKey, CurrentRouteOptions);
        return ScheduleSelectionRequestAsync();
    }

    Task ClearRouteCategoryAsync(string categoryKey)
    {
        if (!_isOpen || _scope != "city") return Task.CompletedTask;
        _routeSelection.ClearCategory(categoryKey, CurrentRouteOptions);
        return ScheduleSelectionRequestAsync();
    }

    async Task ScheduleSelectionRequestAsync()
    {
        CancelSelectionDebounce();
        CancelActiveRequest();
        var sessionToken = _sessionCancellation?.Token ?? CancellationToken.None;
        if (sessionToken.IsCancellationRequested) return;
        var debounce = CancellationTokenSource.CreateLinkedTokenSource(sessionToken);
        _selectionDebounceCancellation = debounce;
        var generation = ++_generation;
        _selectionPending = true;
        _acceptedSnapshot.Clear();
        _isLoading = true;
        _isRefreshing = false;
        await InvokeAsync(StateHasChanged);
        try
        {
            await Task.Delay(TimeSpan.FromMilliseconds(200), debounce.Token);
            if (_disposed || !_isOpen || generation != _generation || debounce.IsCancellationRequested) return;
            if (_retryPolicy.IsCoolingDown(DateTimeOffset.UtcNow))
            {
                _isLoading = false;
                _selectionPending = false;
                _errorCode = StatsOverlayRetryPolicy.CooldownProblemCode(_errorCode);
                await InvokeAsync(StateHasChanged);
                return;
            }
            await RequestSnapshotAsync(generation, retainSnapshot: false);
        }
        catch (OperationCanceledException) when (debounce.IsCancellationRequested) { }
        finally
        {
            if (ReferenceEquals(_selectionDebounceCancellation, debounce))
                _selectionDebounceCancellation = null;
            debounce.Dispose();
        }
    }

    void CancelSelectionDebounce()
    {
        var debounce = _selectionDebounceCancellation;
        _selectionDebounceCancellation = null;
        debounce?.Cancel();
    }

    async Task RequestSnapshotAsync(long generation, bool retainSnapshot)
    {
        if (_disposed || !_isOpen || _sessionCancellation is null || generation != _generation) return;
        if (_requestCancellation is not null)
        {
            if (_requestGate.ActiveGeneration != generation || _requestCancellation.IsCancellationRequested)
                _requestGate.QueueLatest(generation, retainSnapshot);
            return;
        }
        if (_isHidden) return;
        var requestCancellation = CancellationTokenSource.CreateLinkedTokenSource(_sessionCancellation.Token);
        var admission = StatsOverlayRequestAdmissionPolicy.TryBegin(
            _requestGate, _retryPolicy, generation, DateTimeOffset.UtcNow);
        if (admission == StatsOverlayRequestAdmission.CoolingDown)
        {
            requestCancellation.Dispose();
            _isLoading = false;
            _isRefreshing = false;
            _selectionPending = false;
            _errorCode = StatsOverlayRetryPolicy.CooldownProblemCode(_errorCode);
            await InvokeAsync(StateHasChanged);
            return;
        }
        if (admission == StatsOverlayRequestAdmission.AlreadyActive)
        {
            _requestGate.QueueLatest(generation, retainSnapshot);
            requestCancellation.Dispose();
            return;
        }

        _requestCancellation = requestCancellation;
        _needsVisibleRefresh = false;
        var requestToken = requestCancellation.Token;
        _isLoading = !retainSnapshot || _snapshot is null;
        _isRefreshing = retainSnapshot && _snapshot is not null;
        _acceptedSnapshot.MarkFresh();
        _errorCode = null;
        await InvokeAsync(StateHasChanged);
        try
        {
            var requestScope = _scope;
            var requestCity = requestScope == "city" ? _citySlug : null;
            var requestedRouteKeys = requestScope == "city" ? _routeSelection.SelectedKeys.ToArray() : [];
            var response = await StatsEndpoints.QueryAsync(new StatsOverlayRequest
            {
                Scope = requestScope,
                CitySlug = requestCity,
                RouteJoinKeys = requestedRouteKeys
            }, requestToken);
            if (_disposed || !_isOpen || generation != _generation || requestToken.IsCancellationRequested) return;

            if (response.Result.IsSuccess && response.Result.Value is { } snapshot)
            {
                StatsOverlayPresentation nextPresentation;
                try
                {
                    nextPresentation = BuildPresentation(snapshot);
                }
                catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or NullReferenceException)
                {
                    _errorCode = "invalid_response";
                    _acceptedSnapshot.MarkStale();
                    _retryPolicy.RecordFailure(DateTimeOffset.UtcNow);
                    return;
                }

                if (!_acceptedSnapshot.TryAccept(
                        generation, _generation, snapshot, nextPresentation,
                        requestScope, requestCity, requestedRouteKeys))
                {
                    _errorCode = "invalid_response";
                    _acceptedSnapshot.MarkStale();
                    _retryPolicy.RecordFailure(DateTimeOffset.UtcNow);
                }
                else
                {
                    _routeOptions = snapshot.Selection.Scope == "city" ? snapshot.RouteOptions : [];
                    _hasAcceptedCityOptions = snapshot.Selection.Scope == "city";
                    _lastSuccessAtUtc = DateTimeOffset.UtcNow;
                    _needsVisibleRefresh = false;
                    _retryPolicy.RecordSuccess();
                    _acceptedSnapshot.MarkFresh();
                    _errorCode = null;
                    _selectionPending = false;
                }
            }
            else
            {
                _errorCode = response.ProblemCode ?? "dependency_unavailable";
                _acceptedSnapshot.MarkStale();
                _retryPolicy.RecordFailure(DateTimeOffset.UtcNow, response.RetryAfter);
            }
        }
        catch (OperationCanceledException) when (requestToken.IsCancellationRequested)
        {
        }
        catch
        {
            if (!_disposed && generation == _generation)
            {
                _errorCode = "dependency_unavailable";
                _acceptedSnapshot.MarkStale();
                _retryPolicy.RecordFailure(DateTimeOffset.UtcNow);
            }
        }
        finally
        {
            PendingStatsOverlayRequest? pendingRequest = null;
            if (ReferenceEquals(_requestCancellation, requestCancellation))
            {
                _requestCancellation = null;
                pendingRequest = _requestGate.Complete(generation, _generation);
            }
            requestCancellation.Dispose();
            if (!_disposed && generation == _generation)
            {
                _isLoading = false;
                _isRefreshing = false;
                _selectionPending = false;
                await InvokeAsync(StateHasChanged);
            }
            if (pendingRequest is { } nextRequest)
                await InvokeAsync(() => RequestSnapshotAsync(nextRequest.Generation, nextRequest.RetainSnapshot));
        }
    }

    void StartRefreshLoop()
    {
        if (!StatsOverlayRefreshPolicy.ShouldStartLoop(
                _isOpen, _isHidden, _disposed, loopAlreadyRunning: _refreshLoop.IsRunning)
            || _sessionCancellation is null)
            return;
        if (!_refreshLoop.TryStart(_sessionCancellation.Token, out var refresh) || refresh is null) return;
        _ = RefreshLoopAsync(refresh);
    }

    void StopRefreshLoop() => _refreshLoop.Stop();

    async Task RefreshLoopAsync(StatsOverlayRefreshLoopLease refresh)
    {
        var cancellationToken = refresh.Token;
        try
        {
            while (!cancellationToken.IsCancellationRequested
                   && StatsOverlayRefreshPolicy.ShouldRunLoop(_isOpen, _isHidden, _disposed))
            {
                await Task.Delay(TimeSpan.FromSeconds(60), cancellationToken);
                if (StatsOverlayRefreshPolicy.ShouldRunLoop(_isOpen, _isHidden, _disposed)
                    && _requestCancellation is null
                    && !_retryPolicy.IsCoolingDown(DateTimeOffset.UtcNow))
                {
                    if (StatsOverlayRefreshPolicy.ShouldRefresh(
                            DateTimeOffset.UtcNow, _isHidden, _needsVisibleRefresh, _lastSuccessAtUtc))
                        await RequestSnapshotAsync(_generation, retainSnapshot: _snapshot is not null);
                }
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
        finally
        {
            _refreshLoop.Complete(refresh);
        }
    }

    public Task OnStatsVisibilityChanged(bool hidden)
    {
        if (_disposed) return Task.CompletedTask;
        return InvokeAsync(async () =>
        {
            _isHidden = hidden;
            if (hidden)
            {
                _needsVisibleRefresh = true;
                StopRefreshLoop();
                CancelSelectionDebounce();
                CancelActiveRequest();
            }
            else
            {
                StartRefreshLoop();
            }
            StateHasChanged();
            if (StatsOverlayRefreshPolicy.ShouldRefresh(
                    DateTimeOffset.UtcNow, hidden, _needsVisibleRefresh || _selectionPending, _lastSuccessAtUtc)
                && !_retryPolicy.IsCoolingDown(DateTimeOffset.UtcNow))
                await RequestSnapshotAsync(_generation, retainSnapshot: _snapshot is not null);
        });
    }

    void HandlePageVisibilityChanged(bool hidden) => _ = OnStatsVisibilityChanged(hidden);

    StatsOverlayPresentation BuildPresentation(StatsOverlayResponse snapshot) =>
        StatsOverlayProjection.Build(snapshot, key => T.Get(key), ApplicationViewModel.RouteShapes, isDark: _isDark);

    void CancelActiveRequest()
    {
        var request = _requestCancellation;
        request?.Cancel();
    }

    string ScopeDescription(StatsOverlayResponse snapshot) => snapshot.Selection.Scope == "all"
        ? T.Get("StatsScopeAll")
        : T.Get("StatsScopeCity", CityName(snapshot.Cities.FirstOrDefault(city => city.CitySlug == snapshot.Selection.CitySlug)));

    string BubbleDefinition => $"{T.Get("StatsBubbleSize")} {T.Get("StatsBubbleMinimum")}";

    string CityName(StatsCityWindow? city) => city is null ? T.Get("StatsCityUnknown") : T.Get(city.DisplayNameKey);
    string FormatLocalDate(DateOnly date) => date.ToString("D", CultureInfo.GetCultureInfo("en"));
    string FormatUtc(DateTime value) => DateTime.SpecifyKind(value, DateTimeKind.Utc)
        .ToString("yyyy-MM-dd HH:mm 'UTC'", CultureInfo.GetCultureInfo("en"));
    static double? ToDouble(decimal? value) => value is { } number ? (double)number : null;

    string CoverageSummary(StatsCoverage coverage, decimal? kilometers) => coverage.State switch
    {
        "partial" => T.Get("StatsPartialExplanation"),
        "pending" => T.Get("StatsPendingExplanation"),
        "unavailable" => T.Get("StatsUnavailableExplanation"),
        _ when coverage.ExpectedClosedHours == 0 => T.Get("StatsPendingExplanation"),
        _ when kilometers is > 0 => T.Get("StatsCompleteExplanation"),
        _ => T.Get("StatsZeroExplanation")
    };

    static string WarningKey(string warning) => warning switch
    {
        "partial_coverage" => "StatsPartialExplanation",
        "city_days_differ" => "StatsCityDaysDiffer",
        "catalog_changed" => "StatsCatalogChanged",
        "boundary_excluded" => "StatsBoundaryExcluded",
        "historical_membership_unknown" => "StatsHistoricalUnknown",
        "different_route_periods" => "StatsDifferentRoutePeriods",
        _ => "StatsProblemGeneric"
    };

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;
        ApplicationViewModel.PropertyChanged -= HandleRouteMetadataChanged;
        CloseSession();
        EventNotificationService.EventReceived -= HandleEvent;
        NavigationManager.LocationChanged -= HandleLocationChanged;
        PageVisibility.VisibilityChanged -= HandlePageVisibilityChanged;
        if (_dialogModule is null) return;
        try
        {
            await _dialogModule.InvokeVoidAsync("setOpen", _dialogElement, false);
            await _dialogModule.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
    }
}
