@using ChefKnifeStudios.TransitJazz.Client.Core.Services
@using ChefKnifeStudios.TransitJazz.Client.Shared.EventArgs
@using ChefKnifeStudios.TransitJazz.Client.Shared.Resources
@using ChefKnifeStudios.TransitJazz.Client.Shared.Services
@using ChefKnifeStudios.TransitJazz.Client.Shared.Services.JsInterop
@using ChefKnifeStudios.TransitJazz.Shared
@using Microsoft.AspNetCore.Components
@using Microsoft.Extensions.Localization
@implements IDisposable
@inject IEventNotificationService EventNotificationService
@inject ISettingsService SettingsService
@inject IStringLocalizer<RouteFilterResources> Loc
@inject ITransitSynthJsInterop TransitSynth
@inject NavigationManager NavigationManager

<div class="audio-unlock-overlay @(_isDark ? "audio-unlock-overlay--dark" : "")">
    <div class="audio-unlock-overlay__badge">
        <span class="audio-unlock-overlay__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M3 14v-2a9 9 0 0 1 18 0v2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                <path d="M21 15.5a2.5 2.5 0 0 1-2.5 2.5H18a1 1 0 0 1-1-1v-4a1 1 0 0 1 1-1h.5A2.5 2.5 0 0 1 21 14.5v1z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                <path d="M3 15.5A2.5 2.5 0 0 0 5.5 18H6a1 1 0 0 0 1-1v-4a1 1 0 0 0-1-1h-.5A2.5 2.5 0 0 0 3 14.5v1z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
            </svg>
        </span>
        <span class="audio-unlock-overlay__badge-text">@Loc["AudioOverlayExperienceBadge"]</span>
    </div>

    <div class="audio-unlock-overlay__inner">
        <div class="audio-unlock-overlay__header">
            <p>@Loc[_prefix + "Header"]</p>
        </div>
        <div class="audio-unlock-overlay__body">
            <p>@((MarkupString)Loc[_prefix + "Paragraph1"].Value)</p>
            <p>@((MarkupString)Loc[_prefix + "Paragraph2"].Value)</p>
            <p>@((MarkupString)Loc[_prefix + "Paragraph3"].Value)</p>
        </div>
        <button type="button" id="@_buttonId" class="audio-unlock-overlay__button" @onclick="OnEnable">
            @Loc["AudioOverlayButton"]
        </button>
    </div>
</div>

<style>
    .audio-unlock-overlay {
        position: fixed;
        inset: 0;
        z-index: 50;
        display: flex;
        align-items: flex-start;
        justify-content: center;
        overflow-y: auto;
        padding: 4rem 1.5rem;
        background: #fff;
        opacity: 1;
        transition: opacity 1s;
        pointer-events: auto;
    }

    @@media (min-width: 640px) {
        .audio-unlock-overlay {
            align-items: center;
            padding: 6rem 1.5rem;
        }
    }

    .audio-unlock-overlay__inner {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2rem;
        width: 100%;
        max-width: 34rem;
    }

    .audio-unlock-overlay__badge {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 20px;
        position: absolute;
        top: 20px;
        left: 20px;
    }

    @@media (max-width: 639.98px) {
        .audio-unlock-overlay__badge {
            display: none;
        }
    }

    .audio-unlock-overlay__icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 84px;
        height: 84px;
        border-radius: 9999px;
        border: 2px solid rgba(0, 0, 0, 0.9);
        color: rgba(0, 0, 0, 0.9);
        animation: audio-unlock-pulse 2s ease-in-out infinite;
    }

    .audio-unlock-overlay__icon svg {
        width: 44px;
        height: 44px;
    }

    @@keyframes audio-unlock-pulse {
        0% { box-shadow: 0 0 0 0 rgba(0, 0, 0, 0.18); }
        100% { box-shadow: 0 0 0 14px rgba(0, 0, 0, 0); }
    }

    .audio-unlock-overlay__badge-text {
        font-family: monospace;
        font-size: 15px;
        font-weight: 700;
        letter-spacing: 0.32em;
        text-transform: uppercase;
        color: rgba(0, 0, 0, 0.9);
    }

    @@media (min-width: 640px) {
        .audio-unlock-overlay__icon {
            width: 32px;
            height: 32px;
        }
        .audio-unlock-overlay__icon svg {
            width: 24px;
            height: 24px;
        }
        .audio-unlock-overlay__badge-text {
            font-size: 20px;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .audio-unlock-overlay__icon {
            animation: none;
        }
    }

    .audio-unlock-overlay__header {
        width: 100%;
        max-width: 34rem;
        text-align: left;
        font-family: monospace;
        font-size: 12px;
        line-height: 1.65;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: rgba(0, 0, 0, 0.9);
    }

    .audio-unlock-overlay__header p {
        margin: 0;
    }

    @@media (min-width: 640px) {
        .audio-unlock-overlay__header {
            font-size: 13px;
            line-height: 1.7;
        }
    }

    @@media (min-width: 768px) {
        .audio-unlock-overlay__header {
            font-size: 14px;
        }
    }

    .audio-unlock-overlay__body {
        width: 100%;
        max-width: 34rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        text-align: left;
        font-family: monospace;
        font-size: 12px;
        line-height: 1.65;
        letter-spacing: 0.05em;
        color: rgba(0, 0, 0, 0.85);
    }

    .audio-unlock-overlay__body p {
        margin: 0;
    }

    @@media (min-width: 640px) {
        .audio-unlock-overlay__body {
            gap: 1.25rem;
            font-size: 13px;
            line-height: 1.7;
        }
    }

    @@media (min-width: 768px) {
        .audio-unlock-overlay__body {
            font-size: 14px;
        }
    }

    .audio-unlock-overlay__button {
        cursor: pointer;
        border-radius: 9999px;
        border: 1px solid rgba(0, 0, 0, 0.4);
        padding: 0.75rem 2rem;
        background: transparent;
        font-family: Roboto, sans-serif;
        font-size: 11px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: rgba(0, 0, 0, 0.9);
        transition: transform 0.2s, border-color 0.2s, background 0.2s;
    }

    .audio-unlock-overlay__button:hover {
        transform: scale(1.03);
        border-color: rgba(0, 0, 0, 0.8);
        background: rgba(0, 0, 0, 0.05);
    }

    .audio-unlock-overlay--dark {
        background: #1A1C1E;
    }
    .audio-unlock-overlay--dark .audio-unlock-overlay__header,
    .audio-unlock-overlay--dark .audio-unlock-overlay__body p,
    .audio-unlock-overlay--dark .audio-unlock-overlay__badge-text {
        color: rgba(226, 226, 230, 0.9);
    }
    .audio-unlock-overlay--dark .audio-unlock-overlay__icon {
        color: rgba(226, 226, 230, 0.9);
        border-color: rgba(226, 226, 230, 0.9);
    }
    .audio-unlock-overlay--dark .audio-unlock-overlay__icon {
        animation-name: audio-unlock-pulse-dark;
    }
    @@keyframes audio-unlock-pulse-dark {
        0% { box-shadow: 0 0 0 0 rgba(226, 226, 230, 0.22); }
        100% { box-shadow: 0 0 0 14px rgba(226, 226, 230, 0); }
    }
    .audio-unlock-overlay--dark .audio-unlock-overlay__button {
        color: rgba(226, 226, 230, 0.9);
        border-color: rgba(255, 255, 255, 0.4);
    }
    .audio-unlock-overlay--dark .audio-unlock-overlay__button:hover {
        border-color: rgba(255, 255, 255, 0.8);
        background: rgba(255, 255, 255, 0.05);
    }
</style>

@code {
    [Parameter, EditorRequired] public EventCallback OnEnable { get; set; }

    readonly string _buttonId = $"audio-unlock-btn-{Guid.NewGuid():N}";
    string _prefix = "AudioOverlay";
    bool _isDark;

    protected override void OnInitialized()
    {
        _prefix = NavigationManager.ResolveCity() switch
        {
            CityNames.Wmata => "WmataAudioOverlay",
            CityNames.Mbta  => "MbtaAudioOverlay",
            CityNames.Nymta => "NymtaAudioOverlay",
            CityNames.Ttc   => "TtcAudioOverlay",
            CityNames.Septa => "SeptaAudioOverlay",
            CityNames.Rtd   => "RtdAudioOverlay",
            _               => "AudioOverlay"
        };
        _isDark = SettingsService.GetSettings().IsDarkModeEnabled;
        EventNotificationService.EventReceived += HandleEvent;
    }

    void HandleEvent(object sender, IEventArgs e)
    {
        if (e is ThemeChangedEventArgs theme)
        {
            _isDark = theme.IsDarkMode;
            InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose() => EventNotificationService.EventReceived -= HandleEvent;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await TransitSynth.AttachUnlockGestureAsync(_buttonId);
    }
}
