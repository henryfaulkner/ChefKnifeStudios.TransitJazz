{
  "Cities": [
    {
      "Name": "marta",
      "GtfsRtUrls": [ "https://gtfs-rt.itsmarta.com/TMGTFSRealTimeWebService/vehicle/vehiclepositions.pb" ],
      "StaticZipUrls": [ "https://itsmarta.com/google_transit_feed/google_transit.zip" ],
      "RailRealtime": {
        "BaseUrl": "https://developerservices.itsmarta.com:18096/itsmarta/railrealtimearrivals/developerservices/traindata",
        "Enabled": true
      },
      "EmitsTelemetry": true
    },
    {
      "Name": "wmata",
      "GtfsRtUrls": [
        "https://api.wmata.com/gtfs/bus-gtfsrt-vehiclepositions.pb",
        "https://api.wmata.com/gtfs/rail-gtfsrt-vehiclepositions.pb"
      ],
      "StaticZipUrls": [
        "https://api.wmata.com/gtfs/bus-gtfs-static.zip",
        "https://api.wmata.com/gtfs/rail-gtfs-static.zip"
      ],
      "ApiKeyEnvVar": "WMATA_API_KEY",
      "RailRouteIdMap": { "BLUE": "B", "BLUE0": "B", "GREEN": "G", "GREEN0": "G", "ORANGE": "O", "ORANGE0": "O", "RED": "R", "RED0": "R", "SILVER": "S", "SILVER0": "S", "YELLOW": "Y", "YELLOW0": "Y" },
      "EmitsTelemetry": false
    }
  ],
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "Telemetry": {
      "BlobServiceUri": "https://randomstoragehenry.blob.core.windows.net",
      "Container": "parquet",
      "FlushIntervalSeconds": 300,
      "ChannelCapacity": 10000,
      "Enabled": true
    }
  },
  "SignalR": {
    "HubUrl": "https://marta-jazz-dev-ca-server.jollytree-dd5ca774.eastus2.azurecontainerapps.io/hubs/worker-transit"
  },
  "WebApi": {
    "BaseUrl": "https://marta-jazz-dev-ca-server.jollytree-dd5ca774.eastus2.azurecontainerapps.io"
  }
}
